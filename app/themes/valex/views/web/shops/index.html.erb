<%= content_for :script_js do %>

	<script type="text/javascript">

	let map;
	let my_marker;
	let latitude = 25.033708;
	let longitude = 121.564899;

	let marker = [<%= @shops.count %>]
	let infowindow = [<%= @shops.count %>]
	let shop_html= [<%= @shops.count %>]

	const properties = [
		<% @shops.each_with_index do |shop , index| %>
		{
			address: "<%= shop.all_address %>",
			name: "<%= shop.name %>",
			map_icon: "<%= raw shop.map_icon %>",
			service: "<%= shop.service %>",
			type: "<%= shop.category_text %>",
			category_name: "<%= shop.category_name %>",
			position: {
				lat: <%= shop.latitude %>,
				lng: <%= shop.longitude %>,
			},
		},
		<% end %>
	]

	function buildContent(property) {
		const content = document.createElement("div");

		content.classList.add("property");
		content.innerHTML = `
			<div class="icon">
				<i aria-hidden="true" class="${property.category_name} ${property.map_icon}" title="${property.name}"></i>
				<span class="fa-sr-only">${property.type}</span>
			</div>
			<div class="details">
				<div class="name">${property.name}</div>
				<div class="address">${property.address}</div>
				<div class="features">
				<div>
					<i aria-hidden="true" class="fa fa-bed fa-lg bed" title="bedroom"></i>
					<span class="fa-sr-only">bedroom</span>
					<span>${property.service}</span>
				</div>
				</div>
			</div>
			`;
		return content;
	}

	function addMarker(map){

		const location = new google.maps.LatLng( 25.033708 , 121.564899 );

		<% @shops.each_with_index do |shop , index| %>

			shop_html[<%= index %>] = '<%= raw shop.html_index_list %>'

			marker[<%= index %>] = new google.maps.marker.AdvancedMarkerElement({
				map: map,
				position: properties[<%= index %>].position,
				content: buildContent(properties[<%= index %>]),
			  });

			marker[<%= index %>].addListener('click', function() {
				if (marker[<%= index %>].content.classList.contains("highlight")) {
					marker[<%= index %>].content.classList.remove("highlight");
					marker[<%= index %>].zIndex = null;
				}
				else{
					for (var i = 0; i < $("div.property").length; i++){
						$("div.property")[i].classList.remove("highlight");
					}
					marker[<%= index %>].content.classList.add("highlight");
					marker[<%= index %>].zIndex = 1;
				}
			});

			marker[<%= index %>].setMap(map);
		<% end %>


		google.maps.event.addListener(map, 'zoom_changed', function() {
/*
			$("ul.list-noborders").empty();
			<% @shops.each_with_index do |shop , index| %>
				if (map.getBounds().contains(marker[<%= index %>].getPosition()) == true){
					$("ul.list-noborders").prepend(shop_html[<%= index %>])
				}
			<% end %>
*/
		});


		google.maps.event.addListenerOnce(map, 'idle', function() {
			/*
			<% @shops.each_with_index do |shop , index| %>
				if (map.getBounds().contains(marker[<%= index %>].getPosition()) == true){
					$("ul.list-noborders").prepend(shop_html[<%= index %>])
				}
			<% end %>
			*/
		});

		google.maps.event.addListener(map, 'dragend', function() {
			/*
			$("ul.list-noborders").empty();
			<% @shops.each_with_index do |shop , index| %>
				if (map.getBounds().contains(marker[<%= index %>].getPosition()) == true){
					$("ul.list-noborders").prepend(shop_html[<%= index %>])
				}
			<% end %>
			*/
		});
	}


	async function initMap() {

		const { Map } = await google.maps.importLibrary("maps");
		const { AdvancedMarkerElement, PinElement } = await google.maps.importLibrary("marker",);

		let option = {
			enableAcuracy:false, // 提高精確度
			maximumAge:0, // 設定上一次位置資訊的有效期限(毫秒)
			timeout:10000 // 逾時計時器(毫秒)
		};

		navigator.geolocation.getCurrentPosition(
			function(response) {
				const location = new google.maps.LatLng(response.coords.latitude, response.coords.longitude);
				map = new google.maps.Map(document.getElementById("map"), {
					center: location,
					zoom: 16,
					mapId: "CAREGIVER_MAP_ID", // Map ID is required for advanced markers.
				});

				my_marker = new google.maps.marker.AdvancedMarkerElement({
					position: location,
					map: map,
				});
			},
			function error(err) {
				console.warn(`ERROR(${err.code}): ${err.message}`);
				//alert("無法定位你目前位置");

				const location = new google.maps.LatLng( 25.033708 , 121.564899 );
				map = new google.maps.Map(document.getElementById("map"), {
					center: location,
					zoom: 11,
					mapId: "CAREGIVER_MAP_ID", // Map ID is required for advanced markers.
				});

				addMarker(map);

			},
			option
		);

	}

	$(document).ready(function() {
		initMap();
	});

	</script>

<% end %>
