<!-- row -->
<div class="row row-sm">
<!-- Col -->
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
<div class="card order-list">
<div class="card-body">

    <% if @shops.count != 0 %>

        <div class="form-group">
        <div class="row">
            <div class="col-md-9">
                    <ul class="list list-noborders pb-0 mb-0">
                        <% @shops.each_with_index do |shop , index| %>
                        <li class="list-item">
                            <img class="img-sm rounded-circle bg-warning d-flex align-items-center justify-content-center text-white" src="<%#= friend.line_image %>" alt="Profile Image">
                            <div class=" ml-3">
                                <h6 class="mb-1 font-weight-medium"><%= shop.name %></h6>
                                <p class="mb-0 text-muted tx-13"><%= shop.category %></p>
                            </div>
                            <div class="ml-auto d-flex">
                                <label class=""><input class="mr-1" value="<%= shop.category %>" type="checkbox" checked><span></span></label>
                            </div>
                        </li>
                        <% end %>
                    </ul>
            </div>
        </div>
        </div>

    <% end %>
</div>
</div>
</div>
<!-- /Col -->
</div>
<!-- row closed -->

<%= content_for :script_js do %>

	<script type="text/javascript">

	let map;
	let marker;
	let latitude = 25.033708;
	let longitude = 121.564899;

	function addMarker(map){
		const location = new google.maps.LatLng( 25.033708 , 121.564899 );
		let marker = [<%= @shops.count %>]
		let infowindow = [<%= @shops.count %>]
		<% @shops.each_with_index do |shop , index| %>

			marker[<%= index %>] = new google.maps.Marker({
				position: new google.maps.LatLng(new google.maps.LatLng( <%= shop.latitude %>, <%= shop.longitude %> )),
				map: map,
				label: {
					fontFamily: "FontAwesome",
					fontWeight: '100',
					text: eval("'\\u"+"<%= shop.map_icon %>"+"'"),
					color: 'white',
					fontSize: "16px"
				},
			  });

			infowindow[<%= index %>] = new google.maps.InfoWindow({
				content: "<%= shop.name %>",
				disableAutoPan: false,
				hideCloseButton: true,
			});

			marker[<%= index %>].addListener('click', function() {
				<% @shops.each_with_index do |shop , index| %>
					infowindow[<%= index %>].close();
				<% end %>
				infowindow[<%= index %>].open(map, marker[<%= index %>]);

			});

			marker[<%= index %>].setMap(map);

		<% end %>

	}


	async function initMap() {

		const { Map } = await google.maps.importLibrary("maps");
		let option = {
			enableAcuracy:false, // 提高精確度
			maximumAge:0, // 設定上一次位置資訊的有效期限(毫秒)
			timeout:10000 // 逾時計時器(毫秒)
		};

		navigator.geolocation.getCurrentPosition(
			function(response) {
				const location = new google.maps.LatLng(response.coords.latitude, response.coords.longitude);
				map = new Map(document.getElementById("map"), {
					center: location,
					zoom: 16,
				});

				marker = new google.maps.Marker({
					position: location,
					map: map,
				});
			},
			function error(err) {
				console.warn(`ERROR(${err.code}): ${err.message}`);
				//alert("無法定位你目前位置");

				const location = new google.maps.LatLng( 25.033708 , 121.564899 );
				map = new Map(document.getElementById("map"), {
					center: location,
					zoom: 16,
				});

				addMarker(map);
			},
			option
		);

	}

	$(document).ready(function() {
		initMap();
	});

	</script>

<% end %>
