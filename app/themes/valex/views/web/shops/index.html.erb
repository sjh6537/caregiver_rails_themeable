<%= content_for :script_js do %>

	<script type="text/javascript">

	$(document).on('click', ".shop-click", function(event) {
		toggleMarker($(this).data( "id" ));
	});

	let map;
	let my_marker;
	let latitude = 25.033708;
	let longitude = 121.564899;
	let maker_highlight = 0;
	let type_index = 0;

	let marker = [<%= @shops.count %>]
	let infowindow = [<%= @shops.count %>]
	let shop_html= [<%= @shops.count %>]

	const styles = {
		default: [],
		hide: [
			{
			featureType: "poi.business",
			stylers: [{ visibility: "off" }],
			},
			{
			featureType: "transit",
			elementType: "labels.icon",
			stylers: [{ visibility: "off" }],
			},
		],
	};

	const properties = [
		<% @shops.each_with_index do |shop , index| %>
		{
			address: "<%= shop.address %>",
			name: "<%= shop.name %>",
			map_icon: "<%= raw shop.map_icon %>",
			service: "<%= shop.service %>",
			type: "<%= shop.category_text %>",
			category_name: "<%= shop.category_name %>",
			category_index: "<%= shop.category %>",
			position: {
				lat: <%= shop.latitude.nil? ? 0 : shop.latitude %>,
				lng: <%= shop.longitude.nil? ? 0 : shop.longitude %>,
			},
		},
		<% end %>
	]

	function buildContent(property) {
		const content = document.createElement("div");
		content.classList.add("property");
		content.innerHTML = `
			<div class="icon">
				<i aria-hidden="true" class="${property.category_name} ${property.map_icon}" title="${property.name}"></i>
				<span class="fa-sr-only">${property.category_name}</span>
			</div>
			<div class="details">
				<div class="name">${property.name}</div>
				<div class="address">${property.address}</div>
				<div class="features">
				<div>
					<span>${property.service}</span>
				</div>
				</div>
			</div>
			`;
		return content;
	}


	function setShopList(){
		show = false;
		$("ul.list-noborders").empty();

		if (type_index == 0){
			for (var i = 0; i < properties.length; i++){
				if (map.getBounds().contains(properties[i].position) == true){
					show = true;
					$("ul.list-noborders").prepend(shop_html[i]);
				}
			}
		}
		else{
			for (var i = 0; i < properties.length; i++){
				if (properties[i].category_index == type_index){
					if (map.getBounds().contains(properties[i].position) == true){
						show = true;
						$("ul.list-noborders").prepend(shop_html[i]);
					}
				}
			}
		}

		if (maker_highlight !=0){
			item = $('li[data-id="' + maker_highlight +  '"]');
			item.addClass("list-highlight");
			item.prependTo(".list");
			$(".form-group").scrollTop(0);
		}

		if(show == true){
			$("#mark_list").show();
		}
		else{
			$("#mark_list").hide();
		}
	};

	function toggleMarker(index){
		if (marker[index].content.classList.contains("highlight")) {
			marker[index].content.classList.remove("highlight");
			marker[index].zIndex = 1;
			maker_highlight = 0;
		}
		else{
			//for (var i = 0; i < <%= @shops.count %>; i++){
			//	marker[i].content.classList.remove("highlight");
			//	marker[i].zIndex = 1;
			//}
			marker[maker_highlight].content.classList.remove("highlight");
			marker[maker_highlight].zIndex = 1;

			maker_highlight = index;
			marker[maker_highlight].content.classList.add("highlight");
			marker[maker_highlight].zIndex = 999;
			if (map.getZoom() < 16){
				map.setZoom(16);
			}
			if (map.getBounds().contains(marker[maker_highlight].position) != true){
				map.setCenter(marker[maker_highlight].position);
			}

			setShopList();
			$("#mark_list").show();
		}

	}

	function addMarker(map){

		<% @shops.each_with_index do |shop , index| %>
		<% if shop.latitude != nil && shop.latitude != 0 %>

			shop_html[<%= index %>] = '<%= raw shop.html_index_list(index) %>'

			marker[<%= index %>] = new google.maps.marker.AdvancedMarkerElement({
				map: map,
				position: properties[<%= index %>].position,
				content: buildContent(properties[<%= index %>]),
				collisionBehavior: google.maps.CollisionBehavior.OPTIONAL_AND_HIDES_LOWER_PRIORITY
			});

			marker[<%= index %>].addListener('click', function() {
				toggleMarker(<%= index %>);
			});

			marker[<%= index %>].setMap(map);

		<% end %>
		<% end %>

		google.maps.event.addListener(map, 'zoom_changed', function() {
			setShopList();
		});

		google.maps.event.addListenerOnce(map, 'idle', function() {
			setShopList();
		});

		google.maps.event.addListener(map, 'dragend', function() {
			setShopList();
		});

	}

	function addControl(map){

		const locationButton = document.getElementById("location-button");
		map.controls[google.maps.ControlPosition.RIGHT_TOP].push(locationButton);

		locationButton.addEventListener("click", () => {
			// Try HTML5 geolocation.
			if (navigator.geolocation){
				navigator.geolocation.getCurrentPosition(
					(position) => {
						const pos = {
							lat: position.coords.latitude,
							lng: position.coords.longitude,
						};

						//infoWindow.setPosition(pos);
						//infoWindow.setContent("Location found.");
						//infoWindow.open(map);
						map.setCenter(pos);
						my_marker.position = pos;
						setShopList();
					},
					() => {
						alert("無法定位你目前位置");
						//const myLocation = new google.maps.LatLng( latitude , longitude );
						//map.setCenter(myLocation);
						//my_marker.position = myLocation;
					},
				);
			} else {
				// Browser doesn't support Geolocation
				alert("無法定位你目前位置");
				//const myLocation = new google.maps.LatLng( latitude , longitude );
				//map.setCenter(myLocation);
				//my_marker.position = myLocation;
			}
		});

		const typeControl = document.getElementById("type-selector-control");
		map.controls[google.maps.ControlPosition.TOP_LEFT].push(typeControl);
		const typeSelector = document.getElementById("type-selector");

		typeSelector.addEventListener("change", () => {
			type_index = typeSelector.value;
			if (type_index == 0){
				for (var i = 0; i < properties.length; i++){
					marker[i].setMap(map);
				}
			}
			else{
				for (var i = 0; i < properties.length; i++){
					if (properties[i].category_index == type_index){
						marker[i].setMap(map);
					}
					else{
						marker[i].setMap(null);
					}
				}
			}
			setShopList();
		});

		const markerControl = document.getElementById("mark_list");
		map.controls[google.maps.ControlPosition.BOTTOM_CENTER].push(markerControl);

	}

	async function initMap() {

		const { Map } = await google.maps.importLibrary("maps");
		const { AdvancedMarkerElement, PinElement } = await google.maps.importLibrary("marker",);

		let option = {
			enableAcuracy:false, // 提高精確度
			maximumAge:0, // 設定上一次位置資訊的有效期限(毫秒)
			timeout:10000 // 逾時計時器(毫秒)
		};

		navigator.geolocation.getCurrentPosition(
			function(response) {
				const myLocation = new google.maps.LatLng(response.coords.latitude, response.coords.longitude);
				map = new google.maps.Map(document.getElementById("map"), {
					center: myLocation,
					zoom: 16,
					mapId: "CAREGIVER_MAP_ID", //"4504f8b37365c3d0", // Map ID is required for advanced markers.
					mapTypeControl: false,
					//cameraControl: false,
					gmpDraggable: true,
					streetViewControl: false,
					zoomControlOptions: {
						position: google.maps.ControlPosition.RIGHT_TOP,
					},
				});

				my_marker = new google.maps.marker.AdvancedMarkerElement({
					position: myLocation,
					map: map,
				});

				my_marker.addListener('click', function() {
					return;
				});

				addControl(map);
				addMarker(map);
			},
			function error(err) {
				console.warn(`ERROR(${err.code}): ${err.message}`);
				alert("無法定位你目前位置");

				const myLocation = new google.maps.LatLng( latitude , longitude );
				map = new google.maps.Map(document.getElementById("map"), {
					center: myLocation,
					zoom: 16,
					mapId: "4504f8b37365c3d0", //"4504f8b37365c3d0", // Map ID is required for advanced markers.
					mapTypeControl: false,
					//cameraControl: false,
					gmpDraggable: true,
					streetViewControl: false,
					zoomControlOptions: {
						position: google.maps.ControlPosition.RIGHT_TOP,
					},
				});

				my_marker = new google.maps.marker.AdvancedMarkerElement({
					map: map,
				});

				//map.setOptions({ styles: styles["hide"] });
				addControl(map);
				addMarker(map);
			},
			option
		);


	}

	$(document).ready(function() {
		$("#mark_list").hide();
		$("#location-button").hide();
		$("#type-selector-control").hide();

		initMap();

		$("#location-button").show();
		$("#type-selector-control").show();
	});

	</script>

<% end %>
