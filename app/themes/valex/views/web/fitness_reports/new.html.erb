<div class="row row-sm">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
        <div class="card">
            <div class="card-header bg-orange text-center">
                <h3 class="card-title mb-1"><%= t('Table.Fitness_Report') %></h3>
            </div>
            <div class="card-body">
                <%= form_for [:web, @report], as: :user_fitness_report, html: { class: "form-horizontal" } do |f| %>
                <% if @report.errors.any? %>
                <div class="alert alert-danger">
                    <ul>
                        <% @report.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                        <% end %>
                    </ul>
                </div>
                <% end %>


                <div class="form-group">
                    <%= f.label :exercise_type, t('Table.Exercise_Type') %>
                    <span class="text-danger">*</span>
                    <%= f.text_field :exercise_type, class: 'form-control', list: 'exercise_type_list', placeholder: t('Placeholder.Input_Exercise_Type'), required: true %>
                    <datalist id="exercise_type_list">
                        <% @exercise_types.each do |type| %>
                        <option value="<%= type %>">
                            <% end %>
                    </datalist>
                </div>

                <div class="form-group">
                    <%= f.label :fitness_device_id, t('Table.Fitness_Device') %>
                    <%= f.collection_select :fitness_device_id, @fitness_devices, :id, :name, { prompt: t('Placeholder.Selected_Device') }, { class: 'form-control' } %>
                </div>

                <div class="form-group">
                    <%= f.label :start_time, t('Table.Start_Time') %>
                    <span class="text-danger">*</span>
                    <%= f.datetime_local_field :start_time, class: 'form-control', required: true %>
                </div>

                <div class="form-group">
                    <%= f.label :end_time, t('Table.End_Time') %>
                    <span class="text-danger">*</span>
                    <%= f.datetime_local_field :end_time, class: 'form-control', required: true %>
                </div>
                <div class="form-group">
                    <%= f.label :calories_burned, t('Table.Calories_Burned') %>
                    <%= f.number_field :calories_burned, class: 'form-control' %>
                </div>

                <div class="form-group">
                    <%= f.label :intensity, t('Table.Intensity') %>
                    <%= f.text_field :intensity, class: 'form-control' %>
                </div>

                <div class="actions">
                    <%= f.submit t('Button.CREATE'), class: 'btn btn-primary' %>
                    <%= link_to t('Button.GOTO_BACK'), web_user_fitness_report_path, class: 'btn btn-secondary' %>
                </div>
                <% end %>
            </div>
        </div>
    </div>
</div>