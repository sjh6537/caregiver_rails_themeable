<div class="row row-sm">
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title"><%= t('Button.NEW') %> <%= t('Table.Fitness_Report') %></h4>
            </div>
            <div class="card-body">
                <%= form_for [:web, @report], as: :user_fitness_report, html: { class: "form-horizontal" } do |f| %>
                <% if @report.errors.any? %>
                <div class="alert alert-danger">
                    <ul>
                        <% @report.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                        <% end %>
                    </ul>
                </div>
                <% end %>


                <div class="form-group">
                    <%= f.label :exercise_type, t('Table.Exercise_Type') %>
                    <%= f.text_field :exercise_type, class: 'form-control' %>
                </div>

                <div class="form-group">
                    <%= f.label :fitness_device_id, t('Table.Fitness_Device') %>
                    <%# 這裡假設您有一個 FitnessDevice 模型，並且想要一個下拉選單 %>
                    <%# 您需要根據您的實際情況調整 options_from_collection_for_select %>
                    <%= f.collection_select :fitness_device_id, FitnessDevice.all, :id, :name, { prompt: t('Select.Choose') }, { class: 'form-control' } %>
                    <%# 如果沒有 FitnessDevice 模型，或者您想用其他方式輸入，請修改此處 %>
                    <%# 例如，如果您只想輸入文字： %>
                    <%#= f.text_field :fitness_device_id, class: 'form-control' %>
                </div>

                <div class="form-group">
                    <%= f.label :start_time, t('Table.Start_Time') %>
                    <%= f.datetime_local_field :start_time, class: 'form-control' %>
                </div>

                <div class="form-group">
                    <%= f.label :end_time, t('Table.End_Time') %>
                    <%= f.datetime_local_field :end_time, class: 'form-control' %>
                </div>
                <div class="form-group">
                    <%= f.label :calories_burned, t('Table.Calories_Burned') %>
                    <%= f.number_field :calories_burned, class: 'form-control' %>
                </div>

                <div class="form-group">
                    <%= f.label :intensity, t('Table.Intensity') %>
                    <%= f.text_field :intensity, class: 'form-control' %>
                </div>

                <div class="actions">
                    <%= f.submit t('Button.CREATE'), class: 'btn btn-primary' %>
                    <%= link_to t('Button.GOTO_BACK'), web_user_fitness_reports_path, class: 'btn btn-secondary' %>
                </div>
                <% end %>
            </div>
        </div>
    </div>
</div>