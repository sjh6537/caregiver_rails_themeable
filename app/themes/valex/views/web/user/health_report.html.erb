<!-- row -->
<div class="row row-sm">
    <!-- Col -->

    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th colspan="4" class="text-center bg-orange">
                                <h3 class="mt-3"><%= t('Title.HEALTH_REPORT') %>(<%= @reports.count %>筆)</h3>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <% @reports.each do |report| %>
                        <tr>
                            <td colspan="4" class="text-center bg-info text-white mt-2">
                                <h4><%= report.created_at.strftime("%Y-%m-%d %H:%M") %></h4>
                            </td>
                        </tr>
                        <tr>
                            <td><%= t('Table.BMI') %></td>
                            <td><%= report.bmi %></td>
                            <td><%= t('Table.Weight') %></td>
                            <td><%= report.weight %></td>
                        </tr>
                        <tr>
                            <td><%= t('Table.Temperature') %></td>
                            <td><%= report.temperature %></td>
                            <td><%= t('Table.Blood_Pressure1') %></td>
                            <td><%= report.blood_pressure1 %></td>
                        </tr>
                        <tr>
                            <td><%= t('Table.Blood_Pressure2') %></td>
                            <td><%= report.blood_pressure2 %></td>
                            <td><%= t('Table.Heart_Rate') %></td>
                            <td><%= report.heart_rate %></td>
                        </tr>
                        <tr>
                            <td><%= t('Table.Blood_Sugar') %></td>
                            <td><%= report.blood_sugar %></td>
                            <td><%= t('Table.Blood_Oxygen') %></td>
                            <td><%= report.blood_oxygen %></td>
                        </tr>
                        <tr>
                            <td><%= t('Table.Hemoglobin') %></td>
                            <td><%= report.hemoglobin %></td>
                            <td><%= t('Table.Hematocrit') %></td>
                            <td><%= report.hematocrit %></td>
                        </tr>
                        <tr>
                            <td><%= t('Table.Uric_Acid') %></td>
                            <td><%= report.uric_acid %></td>
                            <td><%= t('Table.Ketones') %></td>
                            <td><%= report.ketones %></td>
                        </tr>
                        <tr>
                            <td><%= t('Table.Total_Cholesterol') %></td>
                            <td><%= report.total_cholesterol %></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <% end %>
                    </tbody>
                </table>

            </div>
        </div>
    </div>

    <!-- /Col -->
</div>
<!-- row closed -->