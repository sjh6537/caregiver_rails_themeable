<% if @careds.present? %>
<!-- row -->
<div class="row row-sm">
    <!-- Col -->

    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
        <div class="card order-list">
            <div class="card-body">
                <div class="tx-12 tx-gray-500 mb-3">
                    <% if @careds.present? %>
                    <ul class="list-group">
                        <% @careds.each do |cared_user| %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <%= image_tag cared_user.line_image, class: 'avatar avatar-sm rounded-circle me-2' %>
                                <%= cared_user.line_name %>
                            </span>
                            <h6 class="text-muted ms-2">姓名：<%= cared_user.name %><br />電話：<%= cared_user.phone %></h6><br />
                        </li>
                        <% end %>
                    </ul>
                    <% end %>
                </div>
            </div>
        </div>
    </div>

    <!-- /Col -->
</div>
<!-- row closed -->

<% end %>

<% if @caregivers.present? %>

<!-- row -->
<div class="row row-sm">
    <!-- Col -->
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
        <div class="card order-list">
            <div class="card-body">
                <div class="tx-12 tx-gray-500 mb-3">
                    <% if @caregivers.present? %>
                    <% @caregivers.each do |caregiver| %>
                    <div class="mg-t-5"><%= raw t("Website.Note.You_have_caregiver", name: caregiver.name) %></div>
                    <% end %>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
    <!-- /Col -->
</div>
<!-- row closed -->

<% end %>