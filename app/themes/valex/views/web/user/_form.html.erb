<style>
    span.error {
        color: red;
        font-size: 14px;
    }

    button[type="submit"],
    input[type="submit"] {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;

        /* 確保按鈕有足夠的點擊區域 */
        min-height: 44px;
        min-width: 44px;

        /* 防止被其他元素遮蔽 */
        position: relative;
        z-index: 999;

        /* 確保在小螢幕上可見 */
        margin-bottom: 20px;
    }

    .card-footer {
        padding-bottom: 60px !important;
        margin-bottom: 40px !important;
    }

    /* 針對小螢幕裝置 */
    @media (max-width: 768px) {
        .card-footer {
            padding-bottom: 80px !important;
            position: relative;
        }

        .btn {
            position: sticky;
            bottom: 20px;
        }
    }
</style>

<div class="form-group">
    <div class="row">
        <div class="col-md-12 alert-warning alert-orange">
            <strong><%= raw t("Website.Note.Please_provide_Detail_information") %></strong>
        </div>
    </div>
</div>

<%= simple_form_for @user, :url => web_user_update_path, :defaults => { :id=>"edit_user" , :input_html => { :class => "form-control" } } do |f| %>
<%= f.error_notification %>

<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= raw t("Table.Community") %></label>

        </div>
        <div class="col-md-9">
            <%= @community.description %>
        </div>
    </div>
</div>
<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= raw t("Table.Name") %></label>
        </div>
        <div class="col-md-9">
            <%= f.input :name, label: false, :placeholder => t("Table.Name"), :required => true %>
            <spin id="alert_name" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.Please_Input_Text") %></spin>
        </div>
    </div>
</div>
<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= raw t("Table.ID_Card") %></label>
        </div>
        <div class="col-md-9">
            <%= f.input :id_card, label: false, :placeholder => t("Table.ID_Card"), :required => true %>
            <spin id="alert_id_card" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.Please_Input_Text") %></spin>
            <spin id="alert_id_card_error" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.ID_Card_Error") %></spin>
        </div>
    </div>
</div>
<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= raw t("Table.Contact_Info") %></label>
        </div>
        <div class="col-md-9">
            <%= f.input :phone, label: false, :placeholder => t("Table.Phone"), :required => true %>
            <spin id="alert_phone" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.Please_Input_Text") %></spin>
        </div>
    </div>
</div>
<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= raw t("Table.Birthday") %></label>
        </div>
        <div class="col-md-9">
            <div class="input-group w-100">
                <div class="input-group-prepend">
                    <div class="input-group-text">
                        <i class="typcn typcn-calendar-outline tx-24 lh--9 op-6"></i>
                    </div>
                </div>
                <div class="flex-grow-1">
                    <%= f.input :birthday, label: false, :placeholder => "YYYY-MM-DD", :required => true, input_html: { class: "fc-datepicker form-control w-100" } %>
                </div>
            </div>
            <spin id="alert_birthday" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.Please_Input_Text") %></spin>
        </div>
    </div>
</div>
<div class="card-footer d-flex flex-row-reverse  mg-t-40">
    <div class="form-group">
        <div class="row">
            <button type="submit" class="btn btn-warning waves-effect waves-light" onClick="return checkform();"><%= t("Button.CONFIRM") %></button>
        </div>
    </div>
</div>

<% end %>
<%= content_for :script_js do %>

<script type="text/javascript">
    function hide_alert() {
        $('#alert_name').hide();
        $('#alert_phone').hide();
        $('#alert_id_card').hide();
        $('#alert_id_card_error').hide();
        $('#alert_birthday').hide();
    }

    function checkform() {
        hide_alert();
        ret = true;

        //身份證驗證
        if ($('#user_id_card').val() == "") {
            $('#alert_id_card').show();
            ret = false;
        } else {
            if (!isValidTaiwanID($('#user_id_card').val())) {
                $('#alert_id_card_error').show();
                ret = false;
            }
        }

        if ($('#user_name').val() == "") {
            $('#alert_name').show();
            ret = false;
        }
        if ($('#user_phone').val() == "") {
            $('#alert_phone').show();
            ret = false;
        }
        if ($('#user_birthday').val() == "") {
            $('#alert_birthday').show();
            ret = false;
        }

        if (ret == false)
            return false;
        else
            return true;
    }



    function alert_warning(text) {
        swal({
            title: 'WARNING!',
            text: text,
            type: 'warning',
            confirmButtonColor: '#57a94f'
        });
    };

    function alert_success(text) {
        swal({
            title: 'SUCCESS!',
            text: text,
            type: 'success',
            confirmButtonColor: '#57a94f'
        });
    };

    $(document).ready(function() {
        hide_alert();

        $('.fc-datepicker').datepicker({
            dateFormat: 'yy-mm-dd',
            showOtherMonths: true,
            selectOtherMonths: true
        });

    });

    function isValidTaiwanID(id) {
        id = id.trim();

        if (id.length != 10) {
            console.log("Fail，長度不正確");
            return false
        }


        let countyCode = id.charCodeAt(0);
        if (countyCode < 65 | countyCode > 90) {
            console.log("Fail，字首英文代號，縣市不正確");
            return false
        }

        let genderCode = id.charCodeAt(1);
        if (genderCode != 49 && genderCode != 50) {
            console.log("Fail，性別代碼不正確");
            return false
        }

        let serialCode = id.slice(2)
        for (let i in serialCode) {
            let c = serialCode.charCodeAt(i);
            if (c < 48 | c > 57) {
                console.log("Fail，數字區出現非數字字元");
                return false
            }
        }

        let conver = "ABCDEFGHJKLMNPQRSTUVXYWZIO"
        let weights = [1, 9, 8, 7, 6, 5, 4, 3, 2, 1, 1]

        id = String(conver.indexOf(id[0]) + 10) + id.slice(1);

        checkSum = 0
        for (let i = 0; i < id.length; i++) {
            c = parseInt(id[i])
            w = weights[i]
            checkSum += c * w
        }

        return checkSum % 10 == 0
    }

    function sendline() {

        var msg = 'Hi,你的好友<%= @user.name %>在友伴希望你能當他(她)的照護者 , 點選下方連結加入會員並查看詳情 <%= "#{APP_CONFIG[:line_liff_url]}#{web_caregiver_show_path(@user.id)}" %>';
        var encoded = encodeURIComponent(msg);
        if (encoded) {
            window.location.replace("https://line.me/R/share?text=" + encoded);
        } else {
            alert('傳送錯誤 , 請再分享一次訊息');
        }
        return false;
    }
</script>

<% end %>