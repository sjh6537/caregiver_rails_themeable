<style>
	span.error {
		color: red;
		font-size: 14px;
	}
</style>


<%= simple_form_for @user, :url => web_user_update_path, :defaults => { :id=>"edit_user" , :input_html => { :class => "form-control" } } do |f| %>
<%= f.error_notification %>

        <div class="form-group ">
        <div class="row">
            <div class="col-md-3"></div>
            <div class="col-md-9">
                <div class="mb-2 main-content-label tx-warning"><%= t(:PLEASE_PROVIDE_PERSONAL_INFORMATION, scope: "Notify.Title") %></div>
            </div>
        </div>
        </div>
		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t(:Name, scope: "Table") %></label>
				</div>
				<div class="col-md-9">
					<%= f.input :name, label: false, :placeholder => t(:Name, scope: "Table"), :required => true %>
					<spin id="alert_name" class="alert_text text-danger tx-12"><%= t(:Please_Input_Text, scope: "Notify.Note") %></spin>
				</div>
			</div>
		</div>
		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t(:Contact_Info, scope: "Table") %></label>
				</div>
				<div class="col-md-9">
					<%= f.input :phone, label: false, :placeholder => t(:Phone, scope: "Table"), :required => true %>
					<spin id="alert_phone" class="alert_text text-danger tx-12"><%= t(:Please_Input_Text, scope: "Notify.Note") %></spin>
				</div>
			</div>
		</div>
		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t(:Sex, scope: "Table") %></label>
				</div>
                <div class="col-md-9">
                <select name="user[sex]" id="user_sex" class="form-control nice-select custom-select" required>
                    <% if @user.sex == true %>
                        <option value=1 selected><%= t(:Man, scope: "Table") %></option>
                        <option value=0><%= t(:Woman, scope: "Table") %></option>
                    <% else %>
                        <option value=1><%= t(:Man, scope: "Table") %></option>
                        <option value=0 selected><%= t(:Woman, scope: "Table") %></option>
                    <% end %>
                </select>
                </div>
			</div>
		</div>
		<div class="form-group ">
			<div class="row">
                <div class="col-md-3">
                    <label class="form-label"><%= t(:Address, scope: "Table") %></label>
                </div>
                <div class="col-md-9">
					<select name="user[addr_city]" id="user_addr_city" class="form-control nice-select custom-select">
						<option value="0"><%= t(:Select_city, scope: "Table") %></option>
						<% CITY_CODE.map do |c| %>
                                <% if @user.addr_city == c[:code] %>
                                <option value=<%= c[:code] %> descrition='<%= c[:city] %>' selected><%= c[:city] %></option>
                                <% else %>
								    <option value=<%= c[:code] %> descrition='<%= c[:city] %>'><%= c[:city] %></option>
                                <% end %>
						<% end %>
					</select>
					<spin id="alert_city" class="alert_select_city text-danger tx-12"><%= t(:Please_Select_One_City, scope: "Notify.Note") %></spin>
                </div>
            </div>
        </div>
		<div class="form-group ">
			<div class="row">
                <div class="col-md-3"></div>
                <div class="col-md-9">
                <select name="user[addr_postal]" id="user_addr_postal" class="form-control nice-select custom-select">
                    <option value="0"><%= t(:Select_postal, scope: "Table") %></option>
                </select>
				<spin id="alert_postal" class="alert_select_postal text-danger tx-12"><%= t(:Please_Select_One_Postal, scope: "Notify.Note") %></spin>
                </div>
			</div>
		</div>
		<div class="form-group ">
			<div class="row">
                <div class="col-md-3"></div>
				<div class="col-md-9">
                    <%= f.input :address, label: false, :placeholder => t(:Detail_Address, scope: "Table"), :required => true %>
					<spin id="alert_address" class="alert_text text-danger tx-12"><%= t(:Please_Input_Text, scope: "Notify.Note") %></spin>
				</div>
			</div>
		</div>

		</div>
			<div class="card-footer">
				<button type="submit" class="btn btn-primary waves-effect waves-light" onClick="return checkform();" ><%= t(:UPDATE, scope: "Button") %></button>
			</div>
		</div>

<% end %>



<%= content_for :script_js do %>

    <script type="text/javascript">

        var notice_fail  =   '<div class="alert alert-danger" role="alert">' +
                             '<button aria-label="Close" class="close" data-dismiss="alert" type="button">' +
                             '<span aria-hidden="true">&times;</span></button>';

        var notice_end   =   '</div>';

        function hide_alert(){
            $('#alert_name').hide();
            $('#alert_phone').hide();
            $('#alert_address').hide();
            $('#alert_city').hide();
            $('#alert_postal').hide();
        }

        function checkform() {
            hide_alert();
            ret = true;

            if ($('#user_name').val() == ""){
                $('#alert_name').show();
                ret = false;
            }
            if ($('#user_phone').val() == ""){
                $('#alert_phone').show();
                ret = false;
            }
            if ($('#user_address').val() == ""){
                $('#alert_address').show();
                ret = false;
            }
            if ($('#user_addr_city').val() == "0"){
                $('#alert_city').show();
                ret = false;
            }
            if ($('#user_addr_postal').val() == "0"){
                $('#alert_postal').show();
                ret = false;
            }

            if (ret == false)
                return false;
            else
                return true;
        }

		function refresh_select(data) {
			$('#user_addr_postal').empty();
            $('#user_addr_postal').append('<option value="0"><%= t(:Select_postal, scope: "Table") %></option>');
			$('#user_addr_postal').append(data);
		}

        $(document).on('change', '#user_addr_city', function(event) {
			city_code = $('#user_addr_city').val();
            $('#alert_city').hide();
			$('#alert_postal').hide();

            if ($('#user_addr_city').val() == "0"){
                $('#alert_city').show();
                $('#user_addr_city').focus();
            }

			if ($('#user_addr_postal').val() == "0"){
                $('#alert_postal').show();
                $('#user_addr_postal').focus();
            }

			refresh_select(get_postal_selection(city_code));
        });

        $(document).on('change', '#user_addr_postal', function(event) {
			$('#alert_postal').hide();

			if ($('#user_addr_postal').val() == "0"){
                $('#alert_postal').show();
                $('#user_addr_postal').focus();
            }
        });

        function get_postal_selection(city)
        {
            switch (city){
                default:
                case "1":
                    html_text = '<%= get_postal_selection(1) %>'
                    break;
                case "2":
                    html_text = '<%= get_postal_selection(2) %>'
                    break;
                case "3":
                    html_text = '<%= get_postal_selection(3) %>'
                    break;
                case "4":
                    html_text = '<%= get_postal_selection(4) %>'
                    break;
                case "5":
                    html_text = '<%= get_postal_selection(5) %>'
                    break;
                case "6":
                    html_text = '<%= get_postal_selection(6) %>'
                    break;
                case "7":
                    html_text = '<%= get_postal_selection(7) %>'
                    break;
                case "8":
                    html_text = '<%= get_postal_selection(8) %>'
                    break;
                case "9":
                    html_text = '<%= get_postal_selection(9) %>'
                    break;
                case "10":
                    html_text = '<%= get_postal_selection(10) %>'
                    break;
                case "11":
                    html_text = '<%= get_postal_selection(11) %>'
                    break;
                case "12":
                    html_text = '<%= get_postal_selection(12) %>'
                    break;
                case "13":
                    html_text = '<%= get_postal_selection(13) %>'
                    break;
                case "14":
                    html_text = '<%= get_postal_selection(14) %>'
                    break;
                case "15":
                    html_text = '<%= get_postal_selection(15) %>'
                    break;
                case "16":
                    html_text = '<%= get_postal_selection(16) %>'
                    break;
                case "17":
                    html_text = '<%= get_postal_selection(17) %>'
                    break;
                case "18":
                    html_text = '<%= get_postal_selection(18) %>'
                    break;
                case "19":
                    html_text = '<%= get_postal_selection(19) %>'
                    break;
                case "20":
                    html_text = '<%= get_postal_selection(20) %>'
                    break;
                case "21":
                    html_text = '<%= get_postal_selection(21) %>'
                    break;
                case "22":
                    html_text = '<%= get_postal_selection(22) %>'
                    break;
                case "23":
                    html_text = '<%= get_postal_selection(23) %>'
                    break;
                case "24":
                    html_text = '<%= get_postal_selection(24) %>'
                    break;
            }
            return html_text
        }

        function alert_warning(text)
        {
            swal(
                {
                    title: 'WARNING!',
                    text: text,
                    type: 'warning',
                    confirmButtonColor: '#57a94f'
                });
        };

        function alert_success(text)
        {
            swal(
                {
                    title: 'SUCCESS!',
                    text: text,
                    type: 'success',
                    confirmButtonColor: '#57a94f'
                });
        };

        $(document).ready(function() {
            hide_alert();

            if (<%= @user.addr_city %> != 0){
                refresh_select(get_postal_selection('<%= @user.addr_city %>'));
                if (<%= @user.addr_postal %> != 0){
                    $('#user_addr_postal').val('<%= @user.addr_postal %>').attr('selected','selected');
                }
            }

        });

    </script>

<% end %>

