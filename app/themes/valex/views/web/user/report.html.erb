	<!-- row -->
	<div class="row row-sm">
	    <!-- Col -->

	    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
	        <div class="card">
	            <div class="card-body">
	                <table class="table table-bordered table-hover">
	                    <thead>
	                        <tr>
	                            <th colspan="4" class="text-center bg-orange">
	                                <h3 class="mt-3">量測記錄</h3>
	                            </th>
	                        </tr>
	                    </thead>
	                    <tbody>
	                        <% @reports.each do |report| %>
	                        <tr>
	                            <td colspan="4" class="text-center bg-info text-white mt-2"><h4><%= report.created_at.strftime("%Y-%m-%d %H:%M") %></h4></td>
	                        </tr>
                             <tr>
	                            <td>BMI</td>
	                            <td><%= report.bmi %></td>
	                            <td>體重</td>
	                            <td><%= report.weight %></td>
	                        </tr>
	                        <tr>
	                            <td>體溫</td>
	                            <td><%= report.temperature %></td>
	                            <td>收縮壓</td>
	                            <td><%= report.blood_pressure1 %></td>
	                        </tr>
	                        <tr>
	                            <td>舒張壓:</td>
	                            <td><%= report.blood_pressure2 %></td>
	                            <td>脈博</td>
	                            <td><%= report.heart_rate %></td>
	                        </tr>
	                        <tr>
	                            <td>血糖</td>
	                            <td><%= report.blood_sugar %></td>
	                            <td>血氧</td>
	                            <td><%= report.blood_oxygen %></td>
	                        </tr>
	                        <tr>
	                            <td>血紅素</td>
	                            <td><%= report.hemoglobin %></td>
	                            <td>血球容積比</td>
	                            <td><%= report.hematocrit %></td>
	                        </tr>
                            <tr>
	                            <td>尿酸</td>
	                            <td><%= report.uric_acid %></td>
	                            <td>酮體</td>
	                            <td><%= report.ketones %></td>
	                        </tr>
	                        <tr>
	                            <td>總膽固醇</td>
	                            <td><%= report.total_cholesterol %></td>
	                            <td></td>
	                            <td></td>
	                        </tr>
	                        <% end %>
	                    </tbody>
	                </table>

	            </div>
	        </div>
	    </div>

	    <!-- /Col -->
	</div>
	<!-- row closed -->