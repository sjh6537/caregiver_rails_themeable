<%# app/views/web/user/careds.html.erb %>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header text-center bg-info text-white">
                    <h3 class=""><%= @title_sub %></h3>
                </div>
                <div class="card-body">
                    <% if @careds.any? %>
                    <ul class="list-group">
                        <% @careds.each do |cared_user| %>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <%= image_tag cared_user.line_image, class: 'avatar avatar-sm rounded-circle me-2' %>
                                <%= cared_user.line_name %>
                            </span>
                            <h6 class="text-muted ms-2"><%= t('Table.Name')%>：<%= cared_user.name %><br /><%=t("Table.Phone")%>：<%= cared_user.phone %></h6><br />
                        </li>
                        <% end %>
                    </ul>
                    <% else %>
                    <div class="text-center py-4">
                        <h4 class="text-danger"><%= t('Website.Note.Nobody_be_cared') %></h4>
                    </div>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</div>