<!-- row -->
<div class="row row-sm">
    <!-- Col -->

    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
        <div class="card">
            <div class="card-body">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th colspan="4" class="text-center bg-orange">
                                <h3 class="mt-3"><%= t('Table.Fitness_Report') %>(<%= @reports.count %>筆)</h3>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <% @reports.each do |report| %>
                        <tr>
                            <td colspan="4" class="text-center bg-info text-white mt-2">
                                <h4><%= report.start_time.strftime("%Y-%m-%d %H:%M") %></h4>
                            </td>
                        </tr>
                        <tr>
                            <td><%= t('Table.Exercise_Type') %></td>
                            <td><%= report.exercise_type %></td>
                            <td><%= t('Table.Fitness_Device') %></td>
                            <td><%= report.fitness_device&.name || 'N/A' %></td>
                        </tr>
                        <tr>
                            <td><%= t('Table.Start_Time') %></td>
                            <td><%= report.start_time.strftime("%Y-%m-%d %H:%M:%S") %></td>
                            <td><%= t('Table.End_Time') %></td>
                            <td><%= report.end_time.strftime("%Y-%m-%d %H:%M:%S") %></td>
                        </tr>
                        <tr>
                            <td><%= t('Table.Duration') %></td>
                            <td><%= report.duration %></td>
                            <td><%= t('Table.Calories_Burned') %></td>
                            <td><%= report.calories_burned %></td>
                        </tr>
                        <tr>
                            <td><%= t('Table.Intensity') %></td>
                            <td><%= report.intensity %></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <% end %>
                    </tbody>
                </table>

            </div>
        </div>
    </div>

    <!-- /Col -->
</div>
<!-- row closed -->