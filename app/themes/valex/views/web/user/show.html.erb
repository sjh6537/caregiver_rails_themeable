<style>
    .main-contact-info-header {
        padding-top: 0px;
        padding-left: 0px;
        padding-bottom: 0px;
        border-bottom: 1px solid #e3e8f7;
        position: relative;
    }
</style>

<!-- row -->
<div class="row row-sm">
    <!-- Col -->

    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
        <div class="card bg-orange">
            <div class="card-body">

                <div class="pl-0">

                    <div class="d-flex flex-row justify-content-center mg-b-0">
                        <%= t("Website.Member_Centre") %>
                    </div>

                    <div class="main-profile-overview d-flex main-contact-info-header">

                        <div class="main-img-user profile-user mg-r-2">
                            <img alt="avatar" class="rounded-circle" src=<%= @user.line_image %>><a href=<%= web_user_edit_path %>><i class="fe fe-edit"></i></a>
                            <!-- <a class="fas fa-camera profile-edit" href="JavaScript:void(0);"></a> -->
                        </div>
                        <div class="mr-auto ml-3 pd-t-15 tx-white">
                            <h5 class="mb-1 font-weight-medium"><%= t("Website.Member") %> : <%= @user.name %></h5>
                            <h6 class="mb-1 text-muted"><%= @user.line_name %></h6>
                            <a href="<%= web_user_coins_path %>" class="mb-0 tx-13 tx-white"><%= t("Website.Coin") %> : <%= @user.coins %> <i class="fa-solid fa-magnifying-glass mb-0 mg-l-2"></i> </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- /Col -->
</div>
<!-- row closed -->

<div class="row row-sm">
    <!-- Col -->
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
        <div class="pl-0">

            <div class="d-flex flex-row justify-content-center mg-b-0 pd-10">
                <div class="main-profile-overview d-flex flex-wrap justify-content-center w-100">

                    <div class="text-center mx-3 my-2">
                        <a class="fas fa-solid fa-heartbeat tx-40 tx-orange" href="<%= web_user_health_report_path %>"></a>
                        <p class="mb-1 text-muted tx-center"><%= @user.health_reports.count %></p>
                    </div>
                    <div class="text-center mx-3 my-2">
                        <a class="fas fa-solid fa-dumbbell tx-40 tx-orange" href="<%= web_user_fitness_report_path %>"></a>
                        <p class="mb-1 text-muted tx-center"><%= @user.fitness_reports.count %></p>
                    </div>

                    <div class="text-center mx-3 my-2">
                        <a class="fas fa-solid fa-user tx-40 tx-orange" href="<%= web_user_friends_path %>"></a>
                        <p class="mb-1 text-muted tx-center"><%= @user.friends.count %></p>
                    </div>

                    <div class="text-center mx-3 my-2">
                        <a class="fas fa-solid fa-gear tx-40 tx-orange" href="<%= web_user_requests_path %>"></a>
                        <p class="mb-1 text-muted tx-center"><%= @user.requests.count %></p>
                    </div>

                    <div class="text-center mx-3 my-2">
                        <a class="fas fa-solid fa-circle-dollar-to-slot tx-40 tx-orange" href="<%= web_user_coupons_path(0) %>"></a>
                        <p class="mb-1 text-muted tx-center"><%= @user.coupons.count %></p>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <!-- /Col -->
</div>

<%= render :partial => 'show_caregiver' %>

<%= content_for :script_js do %>

<!-- Internal Select2.min js -->
<script src="/assets/valex/plugins/select2/js/select2.min.js"></script>

<!-- Internal Modal js-->
<script src="/assets/valex/js/modal.js"></script>

<% end %>