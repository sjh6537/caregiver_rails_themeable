
<style>

.card-body {
    padding: 0.5rem;
}

.tab-content img {
    height: 100px;
    width: 100px;
}
.bottom {
    background-color: white;
    border-top: 1px solid rgba(0, 0, 0, 1);
    border-color: #efebdf;
}

.order-list .list .list-item {
    background: #efebdf;
    padding: 0 0 0 0;
}

.border {
    border: 0px solid #e3e8f7 !important;
}
.panel-body {
    padding: 0px;
}

</style>

<!-- row -->
<div class="row row-sm">
<!-- Col -->
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
<div class="card order-list">
<div class="card-body">

    <div class="panel panel-primary tabs-style-2">
        <div class=" tab-menu-heading">
            <div class="tabs-menu1">
                <!-- Tabs -->
                <ul class="nav panel-tabs main-nav-line">
                    <li><a href="#coupons_user" class="nav-link" data-toggle="tab"><%= t("Website.My_Coupons") %></a></li>
                    <li><a href="#coupons_redeem" class="nav-link active" data-toggle="tab"><%= t("Website.Redeem_Coupons") %></a></li>
                </ul>
            </div>
        </div>
        <div class="panel-body tabs-menu-body main-content-body-right border">
            <div class="tab-content">
                <div class="tab-pane" id="coupons_user">
                    <%= render :partial => 'coupons_user' %>
                </div>
                <div class="tab-pane active" id="coupons_redeem">
                    <%= render :partial => 'coupons_redeem' %>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer d-flex flex-row-reverse mg-t-20">
        <div class="form-group">
        <div class="row">
            <%= button_to t("Button.GOTO_ROOT"), web_user_show_path, method: :get, class: "btn btn-warning waves-effect waves-light" %>
        </div>
        </div>
    </div>


</div>
</div>
</div>
<!-- /Col -->
</div>
<!-- row closed -->

<%= content_for :script_js do %>



<% end %>


