<style>

    .btn-with-icon i {
        line-height: 0;
        font-size: 40px;
        margin-right: 5px;
    }

</style>

<!-- row -->
<div class="row row-sm">
<!-- Col -->
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
<div class="card order-list">
<div class="card-body">

    <div class="pl-0">
    <div class="main-profile-overview d-flex">
        <div class="main-img-user profile-user mg-r-20">
            <img alt="avatar" class="rounded-circle" src=<%= @user.line_image %> >
            <!-- <a class="fas fa-camera profile-edit" href="JavaScript:void(0);"></a> -->
        </div>
        <div class="tx-warning mr-auto pd-t-50"><strong><%= @user.line_name %></strong></div>
    </div>
    </div>

    <div class="form-group">
    <div class="row">
        <div class="col-md-12 alert-warning alert-orange">
            <strong><%= raw t("Website.Note.Requests_you_accept") %></strong>
        </div>
    </div>
    </div>


    <% if @accept_requests.count != 0 %>

        <div class="tx-12 tx-gray-500 mb-3">
            <div class="mg-t-5"><%= raw t("Website.Note.You_have_n_accept_requests", num: @accept_requests.count) %></div>
            <div class="mg-t-5"><%= raw t("Website.Note.You_have_n_finish_accept_requests", num: @accept_requests.where("status >= #{REQUEST_FINISH}").count) %></div>
        </div>

        <div class="form-group">
        <div class="row">
            <div class="col-md-9">
                    <ul class="list list-noborders pb-0 mb-0">
                        <% @accept_requests.where("status < ?", REQUEST_FINISH ).each_with_index do |r , index|  %>
                        <li class="list-item">
                            <a class="fas fa-solid fa-screwdriver-wrench tx-30 tx-teal" href="<%= web_request_show_path(r.id) %>"></a>
                            <div class=" ml-3">
                                <h6 class="mb-1 font-weight-medium"><%= r.title %></h6>
                                <p class="mb-0 text-muted tx-13"><%= r.date %></p>
                            </div>

                            <div class="ml-auto tx-13">
                                <% if r.status == REQUEST_FINISH  %>
                                    <p class="mb-1 text-muted d-flex flex-row-reverse"><%= raw t("Website.Note.Accept_request_finish") %></p>
                                <% else %>
                                    <p class="mb-1 text-muted d-flex flex-row-reverse"><%= raw t("Website.Note.Accept_request_new") %></p>
                                <% end %>
                            </div>
                        </li>
                        <% end %>
                    </ul>
            </div>
        </div>
        </div>

    <% else %>

        <div class="form-group  pd-t-20">
        <div class="row">
            <div class="col-md-12 alert-success"><strong><%= t("Website.Note.You_donot_have_accept_request") %></strong></div>
        </div>
        </div>

    <% end %>


    <div class="form-group">
    <div class="row">
        <div class="col-md-12 alert-warning alert-orange">
            <strong><%= raw t("Website.Note.Requests_you_create") %></strong>
        </div>
    </div>
    </div>


    <% if @user.requests.count != 0 %>

        <div class="tx-12 tx-gray-500 mb-3">
            <div class="mg-t-5"><%= raw t("Website.Note.You_have_n_new_requests", num: @user.requests_new.count) %></div>
            <div class="mg-t-5"><%= raw t("Website.Note.You_have_n_finish_requests", num: @user.requests_finish.count) %></div>
            <div class="mg-t-5"><%= raw t("Website.Note.You_have_n_expired_requests", num: @user.requests_expired.count) %></div>
        </div>

        <div class="form-group">
        <div class="row">
            <div class="col-md-9">
                    <ul class="list list-noborders pb-0 mb-0">
                        <% @user.requests_new.each_with_index do |r , index|  %>
                        <li class="list-item">
                            <a class="fas fa-solid fa-screwdriver-wrench tx-30 tx-teal" href="<%= web_request_show_path(r.id) %>"></a>
                            <div class=" ml-3">
                                <h6 class="mb-1 font-weight-medium"><%= r.title %></h6>
                                <p class="mb-0 text-muted tx-13"><%= r.date %></p>
                            </div>

                            <div class="ml-auto tx-13">
                                <% if !r.helper.nil?  %>
                                    <p class="mb-1 text-muted d-flex flex-row-reverse"><%= raw t("Website.Note.Who_agree_this_request", name: r.helper.name) %></p>
                                <% else %>
                                    <p class="mb-1 text-muted d-flex flex-row-reverse"><%= raw t("Website.Note.nobody_agree_this_request") %></p>
                                <% end %>
                            </div>
                        </li>
                        <% end %>
                    </ul>
            </div>
        </div>
        </div>

    <% else %>

        <div class="form-group  pd-t-20">
        <div class="row">
            <div class="col-md-12 alert-success"><strong><%= t("Website.Note.You_donot_have_request") %></strong></div>
        </div>
        </div>

    <% end %>

    <div class="card-footer d-flex flex-row-reverse">
        <div class="form-group">
        <div class="row">
            <%= button_to t("Button.REQUEST"), web_request_new_path(0), method: :get, class: "btn btn-warning waves-effect waves-light" %>
        </div>
        </div>
    </div>


</div>
</div>
</div>
<!-- /Col -->
</div>
<!-- row closed -->

<%= content_for :script_js do %>

    <script type="text/javascript">

    $(document).on('change', "#new_user_request_receiver input:checkbox", function(event) {

        if ($("#new_user_request_receiver input:checkbox:checked").length > 0)
        {
            $("#submit_friends").attr("disabled", false);
        }
        else
        {
            $("#submit_friends").attr("disabled", true);
        }

    });

    $(document).ready(function() {

        $("#submit_friends").attr("disabled", true);
    });

    // https://developers.line.biz/en/docs/line-login/using-line-url-scheme/#sending-text-messages
    function sendLine(){
        var msg = 'Hi,你的好友<%= @user.name %>邀請你加入友伴 , 點選下方連結加入Line友伴官方網站 https://liff.line.me/2004751931-POn4oBxp/';
        var encoded = encodeURIComponent(msg);
        if(encoded){
            //window.location.replace("https://line.me/R/share?text="+encoded );
            setTimeout("location.href='<%= web_user_friends_path %>'",500);
        }else{
            alert('傳送錯誤 , 請再分享一次訊息');
        }
    }

    </script>

	<!-- Internal Select2.min js -->
	<script src="/assets/valex/plugins/select2/js/select2.min.js"></script>

	<!-- Internal form-elements js -->
	<script src="/assets/valex/js/form-elements.js"></script>


<% end %>