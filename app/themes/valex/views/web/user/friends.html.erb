<style>

    .btn-with-icon i {
        line-height: 0;
        font-size: 40px;
        margin-right: 5px;
    }

</style>

<!-- row -->
<div class="row row-sm">
<!-- Col -->
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
<div class="card order-list">
<div class="card-body">

    <div class="pl-0">
    <div class="main-profile-overview d-flex">
        <div class="main-img-user profile-user mg-r-20">
            <img alt="avatar" class="rounded-circle" src=<%= @user.line_image %> >
            <!-- <a class="fas fa-camera profile-edit" href="JavaScript:void(0);"></a> -->
        </div>
        <div class="tx-warning mr-auto pd-t-50"><strong><%= @user.line_name %></strong></div>
    </div>
    </div>

    <div class="form-group">
    <div class="row">
        <div class="col-md-12 alert-warning alert-orange">
            <strong><%= raw t("Website.Note.Invite_line_friends_join") %></strong>
        </div>
    </div>
    </div>

    <div class="d-flex justify-content-between wd-200">
        <button class="btn btn-success btn-block btn-with-icon ht-50" onClick="sendLine();"><i class="fab fa-brands fa-line"></i><%= raw t("Button.LINE") %></button>
    </div>

    <% if @user.friends.count != 0 %>

        <div class="d-flex justify-content-between pd-t-10">
            <p class="tx-12 tx-gray-500 mb-3"><%= raw t("Website.Note.You_have_n_friens", num: @user.friends.count) %></p>
        </div>

        <div class="form-group">
        <div class="row">
            <div class="col-md-9">
                    <ul class="list list-noborders pb-0 mb-0">
                        <% @user.friends.each_with_index do |f , index| %>
                        <li class="list-item">
                            <img class="img-sm rounded-circle bg-warning d-flex align-items-center justify-content-center text-white" src="<%= f.line_image %>" alt="Profile Image">
                            <div class=" ml-3">
                                <h6 class="mb-1 font-weight-medium"><%= f.name %></h6>
                                <p class="mb-0 text-muted tx-13"><%= f.line_name %></p>
                            </div>
                            <% if @user.request_accept_count(f.id) != 0 %>
                                <div class="ml-auto tx-13">
                                    <p class="mb-1 text-muted d-flex flex-row-reverse"><%= raw t("Website.Note.Already_agree_n_times", num: @user.request_accept_count(f.id)) %></p>
                                </div>
                            <% end %>
                        </li>
                        <% end %>
                    </ul>
            </div>
        </div>
        </div>

    <% else %>

        <div class="form-group  pd-t-20">
        <div class="row">
            <div class="col-md-12 alert-success"><strong><%= t("Website.Note.You_donot_have_friend") %></strong></div>
        </div>
        </div>

    <% end %>
</div>
</div>
</div>
<!-- /Col -->
</div>
<!-- row closed -->

<%= content_for :script_js do %>

    <script type="text/javascript">

    $(document).on('change', "#new_user_request_receiver input:checkbox", function(event) {

        if ($("#new_user_request_receiver input:checkbox:checked").length > 0)
        {
            $("#submit_friends").attr("disabled", false);
        }
        else
        {
            $("#submit_friends").attr("disabled", true);
        }

    });

    $(document).ready(function() {

        $("#submit_friends").attr("disabled", true);
    });

    // https://developers.line.biz/en/docs/line-login/using-line-url-scheme/#sending-text-messages
    function sendLine(){
        var msg = 'Hi,你的好友<%= @user.name %>邀請你加入友伴 , 點選下方連結加入Line友伴官方網站 https://liff.line.me/2004751931-POn4oBxp/';
        var encoded = encodeURIComponent(msg);
        if(encoded){
            //window.location.replace("https://line.me/R/share?text="+encoded );
            setTimeout("location.href='<%= web_user_friends_path %>'",500);
        }else{
            alert('傳送錯誤 , 請再分享一次訊息');
        }
    }

    </script>

	<!-- Internal Select2.min js -->
	<script src="/assets/valex/plugins/select2/js/select2.min.js"></script>

	<!-- Internal form-elements js -->
	<script src="/assets/valex/js/form-elements.js"></script>


<% end %>