
<!-- row -->
<div class="row row-sm">
<!-- Col -->
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
<div class="card">
<div class="card-body">

	<div class="pl-0">
		<div class="main-profile-overview d-flex">
			<div class="main-img-user profile-user mg-r-20">
				<img alt="avatar" class="rounded-circle" src=<%= @user.line_image %> >
				<!-- <a class="fas fa-camera profile-edit" href="JavaScript:void(0);"></a> -->
			</div>
			<div class="tx-success mr-auto pd-t-50"><strong><%= @user.line_name %></strong></div>
		</div>
	</div>

	<%= render :partial => 'form' %>

</div>
</div>
</div>
<!-- /Col -->
</div>
<!-- row closed -->

<%= content_for :script_js do %>

    <!-- Internal Select2.min js -->
	<script src="/assets/valex/plugins/select2/js/select2.min.js"></script>

	<!-- Internal Modal js-->
	<script src="/assets/valex/js/modal.js"></script>

<% end %>