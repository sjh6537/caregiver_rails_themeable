
<div class="form-group">
<div class="row">
    <div class="col-md-12 alert-warning alert-orange">
        <strong><%= raw t("Website.Note.You_have_N_Coins",number: @user.coins) %></strong>
    </div>
</div>
</div>

<% if @shops.count == 0 %>

    <div class="form-group">
    <div class="row">
        <div class="col-md-12 alert-warning alert-orange">
            <strong><%= raw t("Website.Note.No_Coupons_can_Redeem") %></strong>
        </div>
    </div>
    </div>

<% else %>

    <div class="form-group">
    <div class="row">
        <div class="col-md-9">
            <ul class="list list-noborders pb-0 mb-0">
                <% @shops.map do | shop | %>
                    <% shop.coupons.where("is_vaild == ?", true).map do | coupon | %>

                            <div class="bottom mg-b-20">
                                <li class="list-item">
                                    <% if coupon.image_file_name.nil? %>
                                        <td><img alt="image" class="img-thumbnail wd-sm-40" src="/assets/valex/img/coupon/default_coupon.png"></td>
                                    <% else %>
                                        <td><img alt="image" class="img-thumbnail wd-sm-40" src="<%= coupon.image %>"></td>
                                    <% end %>

                                    <div class="ml-3">
                                        <h6 class="tx-dark d-flex">
                                            <%= shop.name %>&nbsp;&nbsp;&nbsp;
                                            <a href="<%= web_coupons_show_shop_path(coupon.id) %>" class="x-dark d-flex" >
                                            <b class="tx-primary mb-1 d-flex flex-row-reverse"><%= t("Website.Note.N_Coins_Redeem",number: coupon.redeem ) %></b>
                                            <i class="las la-search waves-effect waves-light mg-t-2 mg-l-5"></i></a>
                                        </h6>
                                        <h6 class="mb-1 font-weight-medium "><%= coupon.name %></h6>
                                        <p class="mb-0 text-muted tx-13"><%= coupon.discount %></p>
                                    </div>
                                </li>


                            </div>

                    <% end %>
                <% end %>
            </ul>
        </div>
    </div>
    </div>

    <% end %>
