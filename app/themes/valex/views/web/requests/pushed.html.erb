<!-- row -->
<div class="row row-sm">
<!-- Col -->
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
<div class="card order-list">
<div class="card-body">

    <div class="pl-0">
    <div class="main-profile-overview d-flex">
        <div class="main-img-user profile-user mg-r-20">
            <img alt="avatar" class="rounded-circle" src=<%= @user.line_image %> >
            <!-- <a class="fas fa-camera profile-edit" href="JavaScript:void(0);"></a> -->
        </div>
        <div class="tx-warning mr-auto pd-t-50"><strong><%= @user.line_name %></strong></div>
    </div>
    </div>

    <% if @request_receivers.nil? %>
        <div class="form-group">
        <div class="row">
            <div class="col-md-12 alert-warning alert-orange">
                <strong><%= raw t("Website.Note.No_push_receivers") %></strong>
            </div>
        </div>
        </div>

        <div class="d-flex justify-content-between pd-t-20">
            <h4 class="card-title mg-b-10"><%= raw t("Website.Note.Your_request",title: @request.title) %></h4>
        </div>
        <div class="d-flex justify-content-between">
            <h4 class="card-title mg-b-10"><%= raw t("Website.Note.Not_pushed_friends") %></h4>
        </div>

    <% else %>
        <div class="form-group">
        <div class="row">
            <div class="col-md-12 alert-warning alert-orange">
                <strong><%= raw t("Website.Note.Request_already_send") %></strong>
            </div>
        </div>
        </div>

        <div class="d-flex justify-content-between pd-t-20">
            <h4 class="card-title mg-b-10"><%= raw t("Website.Note.Your_request",title: @request.title) %></h4>
        </div>
        <div class="d-flex justify-content-between">
            <h4 class="card-title mg-b-10"><%= raw t("Website.Note.Already_pushed_friends") %></h4>
        </div>


        <div class="form-group">
        <div class="row">
            <div class="col-md-9">
                    <ul class="list list-noborders pb-0 mb-0">
                        <% @request_receivers.each_with_index do |request_receiver , index| receiver = request_receiver.receiver %>
                        <li class="list-item">
                            <img class="img-sm rounded-circle bg-warning d-flex align-items-center justify-content-center text-white" src="<%= receiver.line_image %>" alt="Profile Image">
                            <div class=" ml-3">
                                <h6 class="mb-1 font-weight-medium tx-orange"><%= receiver.name %></h6>
                                <p class="mb-0 text-muted tx-13"><%= receiver.line_name %></p>
                            </div>

                            <% if request_receiver.count > 1 %>
                                <div class="ml-auto d-flex">
                                    <h4 class="card-title mg-b-10"><%= raw t("Website.Note.Already_push_n_times", num: request_receiver.count) %></h4>
                                </div>
                            <% end %>
                        </li>
                        <% end %>
                    </ul>
            </div>
        </div>
        </div>


        <div class="d-flex justify-content-between pd-t-20">
            <h4 class="card-title mg-b-10"><%= raw t("Website.Note.System_will_send_notify_after_request_accepted") %></h4>
        </div>
        <div class="d-flex justify-content-between">
            <h4 class="card-title mg-b-10 tx-orange"><%= raw t("Website.Note.And_you_can_get_reward") %></h4>
        </div>

    <% end %>

    <div class="d-flex justify-content-between">
        <h4 class="card-title mg-b-10 mg-t-30"><%= raw t("Website.Note.or_You_can_chiose_line_friends") %></h4>
    </div>

    <div class="d-flex justify-content-between wd-200">
        <button class="btn btn-success btn-block btn-with-icon ht-50" id="sendLine"><i class="fab fa-brands fa-line"></i><%= raw t("Button.LINE") %></button>
    </div>

    <div class="d-flex flex-row-reverse pd-t-80">
        <h4 class="card-title mg-b-10 tx-orange"><%= raw t("Website.Note.Donot_notify_after_request_finish") %></h4>
    </div>

    <div class="card-footer d-flex flex-row-reverse">
        <div class="form-group">
        <div class="row">

            <%= button_to t("Button.GOTO_ROOT"), web_user_show_path, method: :get, class: "btn btn-warning waves-effect waves-light" %>
        </div>
        </div>
    </div>

</div>
</div>
</div>
<!-- /Col -->
</div>
<!-- row closed -->


<%= content_for :script_js do %>

    <script type="text/javascript">

    $(document).on('click', '#sendLine', function(event) {

        var msg = 'Hi,你的好友<%= @user.name %>在友伴有一個需求需要你的幫忙 , 點選下方連結加入會員查看需求 <%= "#{APP_CONFIG[:line_liff_url]}#{web_accept_show_path(@request.id)}" %>';
        var encoded = encodeURIComponent(msg);
        if(encoded){
            window.location.replace("https://line.me/R/share?text="+encoded );
            //setTimeout("location.href='<%= web_request_show_path(@request.id) %>?notice=已分享訊息'",500);
        }else{
            alert('傳送錯誤 , 請再分享一次訊息');
        }

    });


    </script>

<% end %>