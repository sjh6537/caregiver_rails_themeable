<style>
	span.error {
		color: red;
		font-size: 14px;
	}
</style>


<div class="form-group">
<div class="row">
    <div class="col-md-12 alert-warning alert-orange">
        <strong><%= raw t("Website.Note.Please_provide_Request_information") %></strong>
    </div>
</div>
</div>


<%= simple_form_for @request, :url => web_request_path, :defaults => { :id=>"new_request" , :input_html => { :class => "form-control" } } do |f| %>
<%#= f.error_notification %>

        <div class="form-group">
        <div class="row">
            <div class="col-md-3"><label class="form-label"><%= t("Table.Category") %></label></div>
            <div class="col-md-9 row">
                <% REQUEST_CATEGORY[1..].each_with_index do |c , index| %>
                    <% if @category == index+1  %>
                        <div class="col-lg-3">
                            <label class="rdiobox"><input class="category" checked name="user_request[category]" value=<%= index+1 %> type="radio"> <span><%= c %></span></label>
                        </div>
                    <% else %>
                        <div class="col-lg-3">
                            <label class="rdiobox"><input class="category" name="user_request[category]" value=<%= index+1 %> type="radio"> <span><%= c %></span></label>
                        </div>
                    <% end %>
                <% end %>
            </div>
        </div>
        </div>

		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t("Table.Title") %></label>
				</div>
				<div class="col-md-9">
					<%= f.input :title, label: false, :placeholder => t("Notify.Note.Fill_Simple_Title"), :required => true %>
				</div>
			</div>
		</div>


        <div class="form-group ">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label"><%= raw t("Table.Location") %></label>
                </div>
                <div class="col-md-9">
                    <select name="user_request[location_city]" id="location_city" class="form-control nice-select custom-select">
                        <option value="0"><%= raw t("Table.Select_city") %></option>
                        <% CITY_CODE.map do |c| %>
                                <% if @request.location_city == c[:code] %>
                                <option value=<%= c[:code] %> descrition='<%= c[:city] %>' selected><%= c[:city] %></option>
                                <% else %>
                                    <option value=<%= c[:code] %> descrition='<%= c[:city] %>'><%= c[:city] %></option>
                                <% end %>
                        <% end %>
                    </select>
                    <spin id="alert_city" class="alert_select_city text-danger tx-12"><%= raw t("Notify.Note.Please_Select_One_City") %></spin>
                </div>
            </div>
        </div>
        <div class="form-group ">
            <div class="row">
                <div class="col-md-3"></div>
                <div class="col-md-9">
                <select name="user_request[location_postal]" id="location_postal" class="form-control nice-select custom-select">
                    <option value="0"><%= t(:Select_postal, scope: "Table") %></option>
                </select>
                <spin id="alert_postal" class="alert_select_postal text-danger tx-12"><%= raw t("Notify.Note.Please_Select_One_Postal") %></spin>
                </div>
            </div>
        </div>

		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t("Table.Detail_location") %></label>
				</div>
				<div class="col-md-9">
					<%= f.input :location, label: false, :placeholder => t("Website.Note.Please_fill_location"), :required => true %>
				</div>
			</div>
		</div>

        <div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t("Table.Contact_Info") %></label>
				</div>
				<div class="col-md-9">
					<%= f.input :contact_info, label: false, :placeholder => t("Table.Contact_Info"), :required => true %>
				</div>
			</div>
		</div>
		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t("Table.Date") %></label>
				</div>

                <div class="input-group col-md-4">
                    <div class="input-group-prepend">
                        <div class="input-group-text">
                            <i class="typcn typcn-calendar-outline tx-24 lh--9 op-6"></i>
                        </div>
                    </div><input class="form-control" name="user_request[request_date]" type="datetime-local" value=<%= (Time.now+2.hours).strftime('%Y-%m-%dT%R') %>>
                </div>

			</div>
		</div>
		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t("Table.Request_Time") %></label>
				</div>
                <div class="col-md-9">
                <select name="user_request[request_time]" id="request_time" class="form-control nice-select custom-select">
                    <option value="1">1 <%= t(:Hours, scope: "Table") %></option>
                    <option value="2" selected>2 <%= t(:Hours, scope: "Table") %></option>
                    <option value="3">3 <%= t(:Hours, scope: "Table") %></option>
                    <option value="4">4 <%= t(:Hours, scope: "Table") %></option>
                    <option value="8">8 <%= t(:Hours, scope: "Table") %></option>
                    <option value="12">12 <%= t(:Hours, scope: "Table") %></option>
                    <option value="24"><%= t(:Over_Day, scope: "Table") %></option>
                </select>
                </div>
			</div>
		</div>
		<div class="form-group ">
			<div class="row">
                <div class="col-md-3"><%= t("Table.Descrition") %></div>
                <div class="col-md-9">
                    <textarea name="user_request[descrition]" class="form-control" rows="4"><%= @descrition %></textarea>
                </div>
            </div>
		</div>


        <div class="card-footer d-flex flex-row-reverse">
            <div class="form-group">
            <div class="row">
                <button type="submit" class="btn btn-warning waves-effect waves-light" ><%= t("Button.NEXT_STEP") %></button>
            </div>
            </div>
        </div>

<% end %>



<%= content_for :script_js do %>

    <script type="text/javascript">

        $(document).on('change', '.category', function(event) {
            category = "「" + $('input[name="user_request[category]"]:checked').next('span').text() + "」";
            text = '你想要有一個 <font id="category_font" class="tx-danger">' + category +'</font> 類別的需求派工';
            $(".request_title_text").html(text);
            $("#user_request_title").val("請幫忙"+category+"的工作");

        });

        function hide_alert(){
            $('#alert_phone').hide();
            $('#alert_location').hide();
            $('#alert_city').hide();
            $('#alert_postal').hide();
        }

        function checkform() {
            hide_alert();
            ret = true;

            if ($('#user_phone').val() == ""){
                $('#alert_phone').show();
                ret = false;
            }
            if ($('#location').val() == ""){
                $('#alert_location').show();
                ret = false;
            }
            if ($('#location_city').val() == "0"){
                $('#alert_city').show();
                ret = false;
            }
            if ($('#location_postal').val() == "0"){
                $('#alert_postal').show();
                ret = false;
            }

            if (ret == false)
                return false;
            else
                return true;
        }

		function refresh_select(data) {
			$('#location_postal').empty();
            $('#location_postal').append('<option value="0"><%= t(:Select_postal, scope: "Table") %></option>');
			$('#location_postal').append(data);
		}

        $(document).on('change', '#location_city', function(event) {
			city_code = $('#location_city').val();
            $('#alert_city').hide();
			$('#alert_postal').hide();

            if ($('#location_city').val() == "0"){
                $('#alert_city').show();
                $('#location_city').focus();
            }

			if ($('#location_postal').val() == "0"){
                $('#alert_postal').show();
                $('#location_postal').focus();
            }

			refresh_select(get_postal_selection(city_code));
        });

        $(document).on('change', '#location_postal', function(event) {
			$('#alert_postal').hide();

			if ($('#location_postal').val() == "0"){
                $('#alert_postal').show();
                $('#location_postal').focus();
            }
        });

        function get_postal_selection(city)
        {
            switch (city){
                default:
                case "1":
                    html_text = '<%= get_postal_selection(1) %>'
                    break;
                case "2":
                    html_text = '<%= get_postal_selection(2) %>'
                    break;
                case "3":
                    html_text = '<%= get_postal_selection(3) %>'
                    break;
                case "4":
                    html_text = '<%= get_postal_selection(4) %>'
                    break;
                case "5":
                    html_text = '<%= get_postal_selection(5) %>'
                    break;
                case "6":
                    html_text = '<%= get_postal_selection(6) %>'
                    break;
                case "7":
                    html_text = '<%= get_postal_selection(7) %>'
                    break;
                case "8":
                    html_text = '<%= get_postal_selection(8) %>'
                    break;
                case "9":
                    html_text = '<%= get_postal_selection(9) %>'
                    break;
                case "10":
                    html_text = '<%= get_postal_selection(10) %>'
                    break;
                case "11":
                    html_text = '<%= get_postal_selection(11) %>'
                    break;
                case "12":
                    html_text = '<%= get_postal_selection(12) %>'
                    break;
                case "13":
                    html_text = '<%= get_postal_selection(13) %>'
                    break;
                case "14":
                    html_text = '<%= get_postal_selection(14) %>'
                    break;
                case "15":
                    html_text = '<%= get_postal_selection(15) %>'
                    break;
                case "16":
                    html_text = '<%= get_postal_selection(16) %>'
                    break;
                case "17":
                    html_text = '<%= get_postal_selection(17) %>'
                    break;
                case "18":
                    html_text = '<%= get_postal_selection(18) %>'
                    break;
                case "19":
                    html_text = '<%= get_postal_selection(19) %>'
                    break;
                case "20":
                    html_text = '<%= get_postal_selection(20) %>'
                    break;
                case "21":
                    html_text = '<%= get_postal_selection(21) %>'
                    break;
                case "22":
                    html_text = '<%= get_postal_selection(22) %>'
                    break;
                case "23":
                    html_text = '<%= get_postal_selection(23) %>'
                    break;
                case "24":
                    html_text = '<%= get_postal_selection(24) %>'
                    break;
            }
            return html_text
        }


        $(document).ready(function() {
            hide_alert();

            if (<%= @request.location_city %> != 0){
                refresh_select(get_postal_selection('<%= @request.location_city %>'));
                if (<%= @request.location_postal %> != 0){
                    $('#location_postal').val('<%= @request.location_postal %>').attr('selected','selected');
                }
            }

        });

    </script>

<% end %>

