<style>

    .btn-with-icon i {
        line-height: 0;
        font-size: 40px;
        margin-right: 5px;
    }

    .alert-orange {
        color: #fff;
        text-align: center;
        height: 30px;
        padding-top: 5px;
    }

    .ckbox-orange {
        span {
            &:after {
            background-color: #fbbc0b;
            }
        }
    }

    .card-footer {
        border-color: #fbbc0b;
    }

</style>

<!-- row -->
<div class="row row-sm">
<!-- Col -->
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
<div class="card order-list">
<div class="card-body">

    <div class="pl-0">
    <div class="main-profile-overview d-flex">
        <div class="main-img-user profile-user mg-r-20">
            <img alt="avatar" class="rounded-circle" src=<%= @user.line_image %> >
            <!-- <a class="fas fa-camera profile-edit" href="JavaScript:void(0);"></a> -->
        </div>
        <div class="tx-warning mr-auto pd-t-50"><strong><%= @user.line_name %></strong></div>
    </div>
    </div>

    <div class="form-group">
    <div class="row">
        <div class="col-md-3 alert-warning alert-orange">
            <strong><%= raw t("Website.Note.Who_you_want_to_invite_to_help") %></strong>
        </div>
    </div>
    </div>

    <div class="d-flex justify-content-between pd-t-20">
        <h4 class="card-title mg-b-10"><%= raw t("Website.Note.You_can_chiose_friends") %></h4>
    </div>
    <div class="d-flex justify-content-between">
        <h4 class="card-title mg-b-10"><%= raw t("Website.Note.or_You_can_chiose_line_friends") %></h4>
    </div>

    <div class="d-flex justify-content-between wd-200">
        <button class="btn btn-success btn-block btn-with-icon ht-50"><i class="fab fa-brands fa-line"></i><%= raw t("Button.LINE") %></button>
    </div>

    <% if @user.friends.count != 0 %>

        <div class="d-flex justify-content-between pd-t-10">
            <p class="tx-12 tx-gray-500 mb-3"><%= raw t("Website.Note.You_have_n_friens", num: @user.friends.count) %></p>
        </div>

        <%= simple_form_for @send, :url => web_request_send_path, :defaults => { :id=>"request_send" , :input_html => { :class => "form-control" } } do |f| %>

            <div class="form-group">
            <div class="row">
                <div class="col-md-9">
                        <ul class="list list-noborders pb-0 mb-0">
                            <% @friends.each_with_index do |friend , index| %>
                            <li class="list-item">
                                <img class="img-sm rounded-circle bg-warning d-flex align-items-center justify-content-center text-white" src="<%= friend.line_image %>" alt="Profile Image">
                                <div class=" ml-3">
                                    <h6 class="mb-1 font-weight-medium"><%= friend.name %></h6>
                                    <p class="mb-0 text-muted tx-13"><%= friend.line_name %></p>
                                </div>
                                <div class="ml-auto d-flex">
                                    <label class="ckbox ckbox-orange"><input class="mr-1" name="user_request_send[friend_id]" value="<%#= friend.id %>" type="checkbox"><span></span></label>
                                </div>
                            </li>
                            <% end %>
                        </ul>
                </div>
            </div>
            </div>


            <div class="card-footer d-flex flex-row-reverse">
                <div class="form-group">
                <div class="row">
                    <button type="submit" id="submit_friends" class="btn btn-warning waves-effect waves-light" ><%= t("Button.SEND_FRIENDS") %></button>
                </div>
                </div>
            </div>

        <% end %>
    <% else %>

        <div class="form-group  pd-t-20">
        <div class="row">
            <div class="col-md-3 alert-success"><strong><%= t("Website.Note.You_donot_have_friend") %></strong></div>
            <div class="col-md-9"></div>
        </div>
        </div>

    <% end %>
</div>
</div>
</div>
<!-- /Col -->
</div>
<!-- row closed -->

<%= content_for :script_js do %>

    <script type="text/javascript">

    $(document).on('change', "#new_user_request_send input:checkbox", function(event) {

        if ($("#new_user_request_send input:checkbox:checked").length > 0)
        {
            $("#submit_friends").attr("disabled", false);
        }
        else
        {
            $("#submit_friends").attr("disabled", true);
        }

    });

    $(document).ready(function() {

        $("#submit_friends").attr("disabled", true);
    });

    // https://developers.line.biz/en/docs/line-login/using-line-url-scheme/#sending-text-messages
    function sendLine(){
        var msg = "test"
        var encoded = encodeURIComponent(msg);
        if(encoded){
            window.location.replace("https://line.me/R/share?text="+encoded );
        }else{
            alert('message error');
        }
    }

    </script>

	<!-- Internal Select2.min js -->
	<script src="/assets/valex/plugins/select2/js/select2.min.js"></script>

	<!-- Internal form-elements js -->
	<script src="/assets/valex/js/form-elements.js"></script>


<% end %>