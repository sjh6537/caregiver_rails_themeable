<!-- row -->
<div class="row row-sm">
<!-- Col -->
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
<div class="card">
<div class="card-body">

	<div class="pl-0">
		<div class="main-profile-overview d-flex">
			<div class="main-img-user profile-user">
				<img alt="avatar" class="rounded-circle" src=<%= @user.line_image %> >
				<!-- <a class="fas fa-camera profile-edit" href="JavaScript:void(0);"></a> -->
			</div>

			<div class="ml-3 tx-orange pd-t-40">
				<h6 class="mb-1 font-weight-medium tx-16">Hi , <%= @user.name %></h6>
				<% if @category != 0 %>
					<strong><div class="mb-0 tx-orange request_title_text"><%= raw t("Website.Note.You_have_a_category_request", category: REQUEST_CATEGORY[@category]) %></div></strong>
				<% else %>
					<strong><div class="mb-0 tx-orange request_title_text"><%= raw t("Website.Note.You_have_a_request") %></div></strong>
				<% end %>
			</div>

		</div>
	</div>

	<%= render :partial => 'form' %>

</div>
</div>
</div>
<!-- /Col -->
</div>
<!-- row closed -->

<%= content_for :script_js do %>

	<!-- Internal form-elements js -->
	<script src="/assets/valex/js/form-elements.js"></script>

<% end %>