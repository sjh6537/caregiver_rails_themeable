
    <div class="pl-0">
    <div class="main-profile-overview d-flex">
        <div class="main-img-user profile-user mg-r-20">
            <img alt="avatar" class="rounded-circle" src=<%= @user.line_image %> >
            <!-- <a class="fas fa-camera profile-edit" href="JavaScript:void(0);"></a> -->
        </div>
        <div class="tx-warning mr-auto pd-t-50"><strong><%= @user.line_name %></strong></div>
    </div>
    </div>

<% if @request.helper.nil?  %>
    <div class="form-group">
    <div class="row">
        <div class="col-md-12 alert-warning alert-orange">
            <strong><%= raw t("Website.Note.Request_no_receiver") %></strong>
        </div>
    </div>
    </div>
<% else %>
    <div class="form-group">
    <div class="row">
        <div class="col-md-12 alert-warning alert-orange">
            <strong><%= raw t("Website.Note.Request_has_receiver") %></strong>
        </div>
    </div>
    </div>
<% end %>


        <div class="d-flex justify-content-between ">
            <h4 class="card-title mg-b-10"><%= raw @request.content_accept %></h4>
        </div>


    <div class="form-group mg-t-20">
    <div class="row">
        <div class="col-md-12 alert-warning alert-orange">
            <strong><%= raw t("Website.Note.Already_push_receivers") %></strong>
        </div>
    </div>
    </div>

<% if @request_receivers.count == 0 %>

    <div class="pd-20 bg-light">
    <div class="modal d-block pos-static basic-modal">
        <div class="d-flex justify-content-between ">
            <h4 class="card-title mg-b-10"><%= raw t("Website.Note.No_push_receivers") %></h4>
        </div>
    </div>
    </div>

<% else %>

    <div class="form-group">
    <div class="row">
        <div class="col-md-9">
            <ul class="list list-noborders pb-0 mb-0">
                <% @request_receivers.each_with_index do |request_receiver , index| receiver = request_receiver.receiver %>

                        <% if receiver.id == @request.helper_id %>
                            <div class="pd-r-10 pd-l-10 pd-t-10 pd-b-10 bg-light">
                                <li class="list-item">
                                    <img class="img-sm rounded-circle bg-warning d-flex align-items-center justify-content-center text-white" src="<%= receiver.line_image %>" alt="Profile Image">
                                    <div class=" ml-3">
                                        <h6 class="mb-1 font-weight-medium tx-orange"><%= receiver.name %></h6>
                                        <p class="mb-0 text-muted tx-13"><%= receiver.line_name %></p>
                                    </div>
                                    <div class="ml-auto"><p class="mb-0 tx-success d-flex flex-row-reverse"><%= raw t("Website.Note.Accepted_this_request") %></p></div>
                                </li>
                                <div class="ml-auto"><h6 class="tx-dark d-flex"><%= raw t("Table.Contact_Info") %> : <%= receiver.phone %></h6></div>
                                <!--<div class="ml-auto"><%= button_to t("Button.PUSH_CONTACT"), web_request_friends_path, method: :get, class: "btn btn-primary waves-effect waves-light" %></div>-->
                            </div>
                        <% else %>
                            <div class="pd-r-10 pd-l-10 pd-t-10">
                                <li class="list-item">
                                    <img class="img-sm rounded-circle bg-warning d-flex align-items-center justify-content-center text-white" src="<%= receiver.line_image %>" alt="Profile Image">
                                    <div class=" ml-3">
                                        <h6 class="mb-1 font-weight-medium tx-orange"><%= receiver.name %></h6>
                                        <p class="mb-0 text-muted tx-13"><%= receiver.line_name %></p>
                                    </div>

                                    <div class="ml-auto tx-13">
                                        <% if request_receiver.count > 1 %>
                                            <p class="mb-1 text-muted d-flex flex-row-reverse"><%= raw t("Website.Note.Already_push_n_times", num: request_receiver.count) %></p>
                                        <% else %>
                                            <p class="mb-1 text-muted d-flex flex-row-reverse"></p>
                                        <% end %>
                                        <% if request_receiver.consider == 0 %>
                                            <p class="mb-0 tx-primary d-flex flex-row-reverse"><%= raw t("Website.Note.Not_saw_the_request") %></p>
                                        <% else %>
                                            <p class="mb-0 tx-info d-flex flex-row-reverse"><%= raw t("Website.Note.Receiver_consider") %></p>
                                        <% end %>
                                    </div>
                                </li>
                            </div>
                        <% end %>

                <% end %>
            </ul>
        </div>
    </div>
    </div>

<% end %>

    <div class="d-flex justify-content-between pd-t-20">
        <h4 class="card-title mg-b-10"><%= raw t("Website.Note.System_will_send_notify_after_request_accepted") %></h4>
    </div>

    <div class="d-flex justify-content-between">
        <h4 class="card-title mg-b-10 tx-orange"><%= raw t("Website.Note.And_you_can_get_reward") %></h4>
    </div>

    <div class="d-flex flex-row-reverse pd-t-80">
        <h4 class="card-title mg-b-10 tx-orange"><%= raw t("Website.Note.Donot_notify_after_request_finish") %></h4>
    </div>

    <div class="card-footer d-flex flex-row-reverse">
        <div class="form-group">
        <div class="row">
            <%= button_to t("Button.JOIN_CAREGIVER"), web_accept_join_path, method: :get, class: "btn btn-warning waves-effect waves-light" %>
        </div>
        </div>
    </div>


