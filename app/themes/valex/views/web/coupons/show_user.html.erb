
<style>

.card-body {
    padding: 0.5rem;
}

.bottom {
    background-color: white;
    border-top: 1px solid rgba(0, 0, 0, 1);
    border-color: #efebdf;
}

.order-list .list .list-item {
    background: #efebdf;
    padding: 0 0 0 0;
}

.border {
    border: 0px solid #e3e8f7 !important;
}
.panel-body {
    padding: 0px;
}

</style>

<!-- row -->
<div class="row row-sm">
<!-- Col -->
<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
<div class="card order-list">
<div class="card-body">

    <!-- row -->
    <div class="row row-sm">
        <% if @coupon.image_file_name.nil? %>
            <td><img alt="image" class="img-thumbnail wd-sm-40" src="/assets/valex/img/coupon/default_coupon.png"></td>
        <% else %>
            <td><img alt="image" class="img-thumbnail wd-sm-40" src="<%= @coupon.full_image %>"></td>
        <% end %>
    </div>

        <div class="ml-3 mg-t-20">
        <h6 class="tx-dark d-flex"><%= @coupon.name %></h6>
    </div>

    <div class="ml-3 mg-t-20">
        <h6 class="tx-dark d-flex"><b><%= raw t("Table.ShopName") %></b></h6>
        <h6 class="tx-dark d-flex"><%= @shop.name %></h6>
    </div>

    <div class="ml-3 mg-t-20">
        <h6 class="tx-dark d-flex"><b><%= raw t("Table.Discount") %></b></h6>
        <h6 class="tx-dark d-flex"><%= @coupon.discount %></h6>
    </div>

    <div class="ml-3 mg-t-20">
        <h6 class="tx-dark d-flex"><b><%= raw t("Table.Rule") %></b></h6>
        <h6 class="tx-dark d-flex"><%= @coupon.rule %></h6>
    </div>

    <% if @coupon.use_date != nil %>
    <div class="ml-3 mg-t-20">
        <h6 class="tx-dark d-flex"><b><%= raw t("Table.Vaild_Date") %></b></h6>
        <h6 class="tx-dark d-flex"><%= @coupon.use_date %></h6>
    </div>
    <% end %>

    <div class="ml-3 mg-t-20">
        <h6 class="tx-dark d-flex"><b><%= raw t("Table.Comment") %></b></h6>
        <h6 class="tx-dark d-flex"><%= @coupon.comment %></h6>
    </div>

<% if @usercoupon.is_used %>

    <div class="d-flex flex-row justify-content-center mg-b-0 mg-t-20">
        <span id="timer-outputpattern" class="h3 mb-0 text-primary"></span>
    </div>

    <div class="card-footer d-flex flex-row-reverse mg-t-20">
    <div class="form-group">
        <div class="row">
            <input type="button" onclick="history.back()" value=<%= t("Button.GOTO_BACK") %> class="btn btn-warning waves-effect waves-light mg-l-20"></input>
        </div>
    </div>
    </div>

<% else %>

    <div class="card-footer d-flex flex-row-reverse mg-t-20">
        <div class="form-group">
        <div class="row">
            <a class="btn btn-warning waves-effect waves-light mg-l-20" data-val=<%= @usercoupon.id %> data-target="#modal_use" data-toggle="modal" href=""><%= t("Website.Note.Use_Coupon") %></a>
            <input type="button" onclick="history.back()" value=<%= t("Button.CANCEL") %> class="btn btn-warning waves-effect waves-light mg-l-20"></input>
        </div>
        </div>
    </div>

    <div class="modal" id="modal_use">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content tx-size-sm">
                <div class="modal-body tx-center pd-y-20 pd-x-20">
                    <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true">&times;</span></button> <i class="fas fa-solid fa-money-bill-wave tx-100 tx-primary lh-1 mg-t-20 d-inline-block"></i>
                    <h4 class="tx-primary mg-b-20"><%= t("Website.Note.Use_Coupon") %></h4>
                    <p class="mg-b-20 mg-x-20"><%= t("Website.Note.Use_Coupon_info") %></p>
                    <%= button_to t("Website.Note.Use_Coupon"), web_coupons_use_path(@usercoupon.id), method: :post, class: "btn btn-warning waves-effect waves-light" %>
                </div>
            </div>
        </div>
    </div>
<% end %>

</div>
</div>
</div>
<!-- /Col -->
</div>
<!-- row closed -->

<%= content_for :script_js do %>

    <script type="text/javascript">
        $(document).ready(function() {
            $( '#timer-outputpattern' ).countdown( {
                outputPattern: '$minute 分 $second 秒後使用完畢',
                from: <%= @time_left %>
            } );
        });
    </script>

    <!--Internal Counters -->
    <script src="/assets/valex/plugins/counters/waypoints.min.js"></script>
    <script src="/assets/valex/plugins/counters/counterup.min.js"></script>

    <!--Internal Time Counter -->
    <script src="/assets/valex/plugins/counters/jquery.missofis-countdown.js"></script>
    <script src="/assets/valex/plugins/counters/counter.js"></script>


<% end %>


