<style>
    .link-button {
        display: inline;
        padding: 0;
        border: 0;
        font: inherit;
        text-decoration: underline;
        cursor: pointer;
        background: transparent;
        color: currentColor;
        text-decoration:none;
        -webkit-appearance: none;
    }
</style>

<!-- main-header opened -->
<div class="main-header nav nav-item hor-header">
<div class="container">

			<div class="main-header-left ">
				<a class="animated-arrow hor-toggle horizontal-navtoggle"><span></span></a><!-- sidebar-toggle-->
                <!--
				<a class="header-brand" href="index.html">
					<img src="/assets/valex/img/brand/logo-white.png" class="desktop-dark">
					<img src="/assets/valex/img/brand/logo.png" class="desktop-logo">
					<img src="/assets/valex/img/brand/favicon.png" class="desktop-logo-1">
					<img src="/assets/valex/img/brand/favicon-white.png" class="desktop-logo-dark">
				</a>
                -->
			</div>

			<div class="main-header-right">
				<ul class="nav">
					<li class="">
						<div class="dropdown  nav-itemd-none d-md-flex">
							<a href="#" class="d-flex  nav-item nav-link pr-0 country-flag1" data-toggle="dropdown" aria-expanded="false">
								<span class="avatar country-Flag mr-0 align-self-center bg-transparent">
									<% if I18n.locale == :"zh-TW" %>
										<img src="/assets/valex/img/flags/taiwan_flag.jpg" alt="img">
									<% elsif I18n.locale == :en %>
										<img src="/assets/valex/img/flags/us_flag.jpg" alt="img">
									<% end %>
								</span>
								<div class="my-auto">
									<% if I18n.locale == :"zh-TW" %>
										<strong class="mr-2 ml-2 my-auto">Taiwan</strong>
									<% elsif I18n.locale == :en %>
										<strong class="mr-2 ml-2 my-auto">English</strong>
									<% end %>
								</div>
							</a>
							<div class="dropdown-menu dropdown-menu-left dropdown-menu-arrow" x-placement="bottom-end">

								<a href="<%= request.path %>?locale=zh-TW" class="dropdown-item d-flex ">
									<span class="avatar  mr-3 align-self-center bg-transparent"><img src="/assets/valex/img/flags/taiwan_flag.jpg" alt="img"></span>
									<div class="d-flex">
										<span class="mt-2">Taiwan</span>
									</div>
								</a>

								<a href="<%= request.path %>?locale=en" class="dropdown-item d-flex ">
									<span class="avatar  mr-3 align-self-center bg-transparent"><img src="/assets/valex/img/flags/us_flag.jpg" alt="img"></span>
									<div class="d-flex">
										<span class="mt-2">English</span>
									</div>
								</a>

							</div>
						</div>
					</li>
				</ul>
				<div class="nav nav-item  navbar-nav-right ml-auto">
					<div class="nav-link" id="bs-example-navbar-collapse-1">
						<form class="navbar-form" role="search">
							<div class="input-group">
								<input type="text" class="form-control" placeholder="Search">
								<span class="input-group-btn">
									<button type="reset" class="btn btn-default">
										<i class="fas fa-times"></i>
									</button>
									<!--
									<button type="submit" class="btn btn-default nav-link resp-btn">
										<svg xmlns="http://www.w3.org/2000/svg" class="header-icon-svgs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
									</button>
									-->
								</span>
							</div>
						</form>
					</div>

					<!-- message -->
					<%#= render :partial => 'layouts/_header_message' %>

					<!-- notification -->
					<%#= render :partial => 'layouts/_header_notification' %>

					<div class="nav-item full-screen fullscreen-button">
						<a class="new nav-link full-screen-link" href="#"><svg xmlns="http://www.w3.org/2000/svg" class="header-icon-svgs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-maximize"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg></a>
					</div>
					<% if current_user.nil? %>
			            <div class="mg-t-10 mg-l-10 text-primary">
			                <h6> <span> <i class="icon fa fa-user"></i><a href=<%= new_user_session_path %> > User Login</a></span></h6>
						</div>
					<% else %>
						<div class="dropdown main-profile-menu nav nav-item nav-link">
							<a class="profile-user d-flex" href=""><img alt="" src=<%= current_user.profile.line_image %> ></a>
							<div class="dropdown-menu">
								<div class="main-header-profile bg-primary p-3">
									<div class="d-flex wd-100p">
										<div class="main-img-user"><img alt="" src=<%= current_user.profile.line_image %> class=""></div>
										<div class="ml-3 my-auto">
											<h6><%= current_user.name %></h6>
										</div>
									</div>
								</div>
                                <form class="button_to" method="delete" action="/logout">
                                <input type="hidden" name="_method" value="delete" autocomplete="off">
                                <button class="link-button dropdown-item" type="submit"><i class="bx bx-log-out"></i> Sign Out</button>
                                </form>
							</div>
						</div>
					<% end %>
					<!-- right sidebar toggle -->
					<!--
					<div class="dropdown main-header-message right-toggle">
						<a class="nav-link pr-0" data-toggle="sidebar-right" data-target=".sidebar-right">
							<svg xmlns="http://www.w3.org/2000/svg" class="header-icon-svgs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-menu"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
						</a>
					</div>
					-->
				</div>
			</div>

</div>
</div>
<!-- /main-header -->


