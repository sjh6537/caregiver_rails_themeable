		-->
	</div>
	<!-- /breadcrumb -->
	<!-- row opened -->

	<div class="row">
		<div class="col-lg-6 col-md-12">
			<div class="card" id="basic-alert">
				<div class="card-body">
					<div>
						<h6 class="card-title mb-1"><%= t("Notify.Title.LOGS") %></h6>
						<p class="text-muted card-sub-title"><%= t("Notify.Note.More_Logs") %></p>
					</div>

					<% @history_logs.map do |h| %>

						<% if h.target == LOG_USERCOIN %>
							<div class="alert alert-warning" role="alert">
						<% elsif h.action == ACTION_DEL %>
							<div class="alert alert-danger" role="alert">
						<% else %>
							<div class="alert alert-success" role="alert">
						<% end %>
							<button aria-label="Close" class="close" data-dismiss="alert" type="button">
								<span aria-hidden="true">&times;</span>
							</button>
							<strong><%= h.happen_date %></strong> <%= h.description %>
						</div>

					<% end %>
				</div>
			</div>
		</div>
		<div class="col-lg-6 col-md-12">
			<div class="card">
				<div class="card-body">
		        	<div>
						<h6 class="card-title mb-1"><%= t("Notify.Title.SCHEDULE_TABLE") %></h6>
						<p class="text-muted card-sub-title"><%= t("Notify.Note.More_Logs") %></p>
					</div>
			        <div class="table-responsive border-top userlist-table ht-550">
			            <table id="example" class="table key-buttons table-striped text-md-nowrap card-table mb-0 table-vcenter">
			                <thead>
			                    <tr>
			                        <th class="border-bottom-0 wd-lg-40p"><span><%= t("Table.Schedule_name") %></span></th>
			                        <th class="border-bottom-0 wd-lg-30p"><span><%= t("Table.Schedule_time") %></span></th>
			                        <th class="border-bottom-0 wd-lg-30p"><span><%= t("Table.Status") %></span></th>
			                    </tr>
			                </thead>
			                <% if @schedules.present? %>
			                    <tbody>
			                    <% @schedules.each do |schedule| %>
			                        <tr>
			                            <td><%= schedule.schedule_name %></td>
			                            <td><%= schedule.scheduled_time_text %></td>
			                            <td><%= raw schedule.status_text %></td>
			                        </tr>
			                    <% end %>
			                    </tbody>
			                <% else %>
			                    <tbody>
			                    </tbody>
			                <% end %>
			            </table>
			        </div>
			    </div>
			</div>
		</div>
	</div>
	<!-- row close -->

	<!-- row opened -->
	<div class="row row-sm row-deck">

	</div>
	<!-- /row -->

</div>
<!-- /Container -->
