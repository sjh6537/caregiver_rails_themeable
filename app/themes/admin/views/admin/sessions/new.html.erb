
<div class="container-fluid">

<div class="breadcrumb-header justify-content-between">
</div>

<div class="row">
<div class="col-md-10 col-lg-8 col-xl-6 mx-auto d-block">
<div class="card card-body pd-20 pd-md-40 border shadow-none">

    <%= simple_form_for(resource, :as => resource_name, :url => session_path(resource_name), :html => { :calss => "form-horizontal"}) do |f| %>

        <span class="TOP"></span>
        <p style="font-family: Helvetica;font-size: 14pt;text-align: ce<%= APP_CONFIG[:site_name] %>r: gray;"><%= t(APP_CONFIG[:site_name], :scope => "Login",:name => APP_CONFIG[:site_name]) %></p>
        <br />

        <span style="color:red">
            <% flash.each do |name, msg| %>
                  <%= content_tag :div, msg, :class => "flash_#{name}" if msg.is_a?(String) %>
            <% end %>
        </span>

        <div class="form-group">
            <%= f.input :account, label: false, placeholder: t("Login.Account"), :autofocus => true, input_html: { class: "form-control" } %>
        </div>

        <div class="form-group">
            <%= f.input :password, label: false, placeholder: t("Login.Password"), input_html: { class: "form-control" } %>
        </div>   

        <div class="form-group mb-0 mt-3 justify-content-end">
            <input type="submit" class="btn btn-primary" value=<%= t("Login.Sign_in") %> />
        </div>
        
    <% end %>


</div>
</div>
</div>
</div>



