<% content_for :head_css do %>
<link href="/assets/valex/plugins/datatable/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
<% end %>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-chart-line me-2"></i><%= t(:FITNESS_DEVICE_USAGES_TABLE, scope: "Title") %></h3>
                <div class="card-tools">
                    <%= button_tag class: "btn btn-success btn-sm", onclick: "window.location.reload()" do %>
                    <i class="fas fa-sync-alt me-1"></i><%= t(:Refresh, scope: "Button") %>
                    <% end %>
                </div>
            </div>
            <div class="card-body">
                <!-- 搜尋篩選器 -->
                <%= form_with url: admin_fitness_device_usages_path, method: :get, local: true, class: "mb-4" do |f| %>
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label"><%= t(:Community, scope: "Table") %></label>
                        <%= f.select :community_id, options_from_collection_for_select(available_communities, :id, :name, params[:community_id]), 
                          { prompt: t(:All_Communities, scope: "Placeholder") }, 
                          { class: "form-select form-control" } %>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label"><%= t(:Fitness_Device, scope: "Table") %></label>
                        <%= f.select :device_id, options_from_collection_for_select(available_devices, :id, :display_name, params[:device_id]), 
                          { prompt: t(:All_Devices, scope: "Placeholder") }, 
                          { class: "form-select form-control" } %>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label"><%= t(:Status, scope: "Table") %></label>
                        <%= f.select :status, options_for_select([[t(:All_Status, scope: "Placeholder"), ''], [t(:In_Use, scope: "Table"), 'in_use'], [t(:Completed, scope: "Status"), 'completed']], params[:status]), 
                          {}, 
                          { class: "form-select form-control" } %>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label"><%= t(:Start_Date, scope: "Table") %></label>
                        <%= f.date_field :start_date, value: params[:start_date], class: "form-control" %>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label"><%= t(:End_Date, scope: "Table") %></label>
                        <%= f.date_field :end_date, value: params[:end_date], class: "form-control" %>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label"><%= t(:User_Name, scope: "Table") %></label>
                        <%= f.text_field :user_name, value: params[:user_name], class: "form-control", placeholder: t(:Enter_User_Name, scope: "Placeholder") %>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-auto">
                        <%= f.submit t(:Search, scope: "Button"), class: "btn btn-primary" %>
                        <%= link_to t(:RESET, scope: "Button"), admin_fitness_device_usages_path, class: "btn btn-secondary ms-2" %>
                    </div>
                </div>
                <% end %>

                <!-- 統計資訊 -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="info-box bg-info">
                            <span class="info-box-icon"><i class="fas fa-list"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text"><%= t(:Total_Records, scope: "Table") %></span>
                                <span class="info-box-number"><%= @usage_records.respond_to?(:total_count) ? @usage_records.total_count : @usage_records.count %></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box bg-success">
                            <span class="info-box-icon"><i class="fas fa-check-circle"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text"><%= t(:Completed, scope: "Status") %></span>
                                <span class="info-box-number"><%= @usage_records.where(status: :completed).count %></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box bg-warning">
                            <span class="info-box-icon"><i class="fas fa-clock"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text"><%= t(:In_Use, scope: "Table") %></span>
                                <span class="info-box-number"><%= @usage_records.where(status: :in_use).count %></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box bg-primary">
                            <span class="info-box-icon"><i class="fas fa-clock"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text"><%= t(:Average_Duration, scope: "Table") %></span>
                                <span class="info-box-number">
                                    <%= number_with_delimiter(@avg_duration&.round || 0) %> <%= t(:Minutes, scope: "Table") %>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 資料表格 -->
                <div class="table-responsive">
                    <table id="usageTable" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th><%= t(:User, scope: "Table") %></th>
                                <th><%= t(:Fitness_Device, scope: "Table") %></th>
                                <th><%= t(:Community, scope: "Table") %></th>
                                <th><%= t(:Start_Time, scope: "Table") %></th>
                                <th><%= t(:End_Time, scope: "Table") %></th>
                                <th><%= t(:Usage_Duration, scope: "Table") %></th>
                                <!-- 移除：消耗卡路里、狀態、備註 欄位 -->
                                <th><%= t(:Action, scope: "Table") %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @usage_records.each do |usage| %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div>
                                            <div class="fw-bold"><%= usage.user.name %></div>
                                            <small class="text-muted"><%= usage.user.email if usage.user.email.present? %></small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <div class="fw-bold"><%= usage.fitness_device.name %></div>
                                        <small class="text-muted"><%= usage.fitness_device.fitness_device_type.name %></small>
                                    </div>
                                </td>
                                <td><%= usage.fitness_device.community.name %></td>
                                <td><%= usage.start_time.strftime('%m/%d %H:%M') if usage.start_time %></td>
                                <td>
                                    <% if usage.end_time %>
                                    <%= usage.end_time.strftime('%m/%d %H:%M') %>
                                    <% else %>
                                    <span class="badge bg-warning"><%= t(:In_Use, scope: "Table") %></span>
                                    <% end %>
                                </td>
                                <td>
                                    <% if usage.duration_minutes %>
                                    <%= usage.duration_formatted %>
                                    <% else %>
                                    <span class="text-muted">--</span>
                                    <% end %>
                                </td>
                                <!-- 已移除：消耗卡路里 / 狀態 / 備註 -->
                                <td>
                                    <div class="btn-group" role="group">
                                        <%= link_to admin_fitness_device_usage_path(usage), class: "btn btn-sm btn-outline-primary" do %>
                                        <i class="fas fa-eye"></i>
                                        <% end %>

                                        <% if usage.in_use? %>
                                        <%= button_to end_usage_admin_fitness_device_usage_path(usage), method: :patch,
                                      confirm: t(:Confirm_End_Usage, scope: "Notice"),
                                      class: "btn btn-sm btn-outline-warning",
                                      form_class: "d-inline" do %>
                                        <i class="fas fa-stop"></i>
                                        <% end %>
                                        <% end %>

                                        <%= button_to admin_fitness_device_usage_path(usage), method: :delete,
                                      confirm: t(:Confirm_Delete_Usage_Record, user_name: usage.user.name, device_name: usage.fitness_device.name, scope: "Notice"),
                                      class: "btn btn-sm btn-outline-danger",
                                      form_class: "d-inline" do %>
                                        <i class="fas fa-trash"></i>
                                        <% end %>
                                    </div>
                                </td>
                            </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>

                <!-- 分頁 -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>
                        <% if defined?(Kaminari) && @usage_records.respond_to?(:total_count) %>
                        <%= t(:Showing_Records, 
                              start: @usage_records.offset_value + 1, 
                              end: [@usage_records.offset_value + @usage_records.current_page_record_count, @usage_records.total_count].min, 
                              total: @usage_records.total_count) %>
                        <% else %>
                        <%= t(:Total_Records_Count, total: @usage_records.count) %>
                        <% end %>
                    </div>
                    <div>
                        <% if defined?(Kaminari) && @usage_records.respond_to?(:total_count) %>
                        <%= paginate @usage_records, theme: 'twitter-bootstrap-4' %>
                        <% end %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<% content_for :script_js do %>
<script src="/assets/valex/plugins/datatable/js/jquery.dataTables.min.js"></script>
<script src="/assets/valex/plugins/datatable/js/dataTables.bootstrap4.js"></script>
<script>
    (function() {
            // 等待 DOM 完全就緒
            document.addEventListener('DOMContentLoaded', function() {
                        // 初始化 DataTable（確保 DataTables 與 jQuery 已在 layout 中載入）
                        if (window.jQuery && $.fn.DataTable) {
                            $('#usageTable').DataTable({
                                        paging: false,