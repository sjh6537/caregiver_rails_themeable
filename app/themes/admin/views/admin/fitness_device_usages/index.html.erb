<%= render 'admin/shared/breadcrumb' %>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-chart-line me-2"></i>健身器材使用記錄</h3>
                <div class="card-tools">
                    <%= button_tag class: "btn btn-success btn-sm", onclick: "window.location.reload()" do %>
                    <i class="fas fa-sync-alt me-1"></i>重新整理
                    <% end %>
                </div>
            </div>
            <div class="card-body">
                <!-- 篩選器 -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <%= form_with url: admin_fitness_device_usages_path, method: :get, local: true, class: "d-inline" do |f| %>
                        <%= f.select :community_id, options_from_collection_for_select(available_communities, :id, :name, params[:community_id]), 
                          { prompt: "所有社區" }, 
                          { class: "form-select", onchange: "this.form.submit()" } %>
                        <% end %>
                    </div>
                    <div class="col-md-3">
                        <%= form_with url: admin_fitness_device_usages_path, method: :get, local: true, class: "d-inline" do |f| %>
                        <%= f.hidden_field :community_id, value: params[:community_id] %>
                        <%= f.select :device_id, options_from_collection_for_select(available_devices, :id, :display_name, params[:device_id]), 
                          { prompt: "所有設備" }, 
                          { class: "form-select", onchange: "this.form.submit()" } %>
                        <% end %>
                    </div>
                    <div class="col-md-3">
                        <%= form_with url: admin_fitness_device_usages_path, method: :get, local: true, class: "d-inline" do |f| %>
                        <%= f.hidden_field :community_id, value: params[:community_id] %>
                        <%= f.hidden_field :device_id, value: params[:device_id] %>
                        <%= f.select :status, options_for_select([['所有狀態', ''], ['使用中', 'in_use'], ['已完成', 'completed']], params[:status]), 
                          {}, 
                          { class: "form-select", onchange: "this.form.submit()" } %>
                        <% end %>
                    </div>
                    <div class="col-md-3">
                        <%= form_with url: admin_fitness_device_usages_path, method: :get, local: true, class: "d-inline" do |f| %>
                        <%= f.hidden_field :community_id, value: params[:community_id] %>
                        <%= f.hidden_field :device_id, value: params[:device_id] %>
                        <%= f.hidden_field :status, value: params[:status] %>
                        <%= f.date_field :date, value: params[:date], class: "form-control", placeholder: "選擇日期", onchange: "this.form.submit()" %>
                        <% end %>
                    </div>
                </div>

                <!-- 統計資訊 -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="info-box bg-info">
                            <span class="info-box-icon"><i class="fas fa-list"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">總記錄數</span>
                                <span class="info-box-number"><%= @usage_records.total_count %></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box bg-success">
                            <span class="info-box-icon"><i class="fas fa-check-circle"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">已完成</span>
                                <span class="info-box-number"><%= @usage_records.where(status: :completed).count %></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box bg-warning">
                            <span class="info-box-icon"><i class="fas fa-clock"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">使用中</span>
                                <span class="info-box-number"><%= @usage_records.where(status: :in_use).count %></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="info-box bg-primary">
                            <span class="info-box-icon"><i class="fas fa-clock"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">平均時長</span>
                                <span class="info-box-number">
                                    <%= number_with_delimiter(@avg_duration&.round || 0) %> 分鐘
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 資料表格 -->
                <div class="table-responsive">
                    <table id="usageTable" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>使用者</th>
                                <th>健身器材</th>
                                <th>所屬社區</th>
                                <th>開始時間</th>
                                <th>結束時間</th>
                                <th>使用時長</th>
                                <th>消耗卡路里</th>
                                <th>狀態</th>
                                <th>備註</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @usage_records.each do |usage| %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div>
                                            <div class="fw-bold"><%= usage.user.name %></div>
                                            <small class="text-muted"><%= usage.user.email if usage.user.email.present? %></small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <div class="fw-bold"><%= usage.fitness_device.name %></div>
                                        <small class="text-muted"><%= usage.fitness_device.fitness_device_type.name %></small>
                                    </div>
                                </td>
                                <td><%= usage.fitness_device.community.name %></td>
                                <td><%= usage.start_time.strftime('%m/%d %H:%M') if usage.start_time %></td>
                                <td>
                                    <% if usage.end_time %>
                                    <%= usage.end_time.strftime('%m/%d %H:%M') %>
                                    <% else %>
                                    <span class="badge bg-warning">使用中</span>
                                    <% end %>
                                </td>
                                <td>
                                    <% if usage.duration_minutes %>
                                    <%= usage.duration_formatted %>
                                    <% else %>
                                    <span class="text-muted">--</span>
                                    <% end %>
                                </td>
                                <td>
                                    <% if usage.calories_burned %>
                                    <%= number_with_delimiter(usage.calories_burned) %> 卡
                                    <% else %>
                                    <span class="text-muted">--</span>
                                    <% end %>
                                </td>
                                <td>
                                    <% if usage.in_use? %>
                                    <span class="badge bg-warning">使用中</span>
                                    <% else %>
                                    <span class="badge bg-success">已完成</span>
                                    <% end %>
                                </td>
                                <td>
                                    <% if usage.notes.present? %>
                                    <span data-bs-toggle="tooltip" title="<%= usage.notes %>">
                                        <%= truncate(usage.notes, length: 20) %>
                                    </span>
                                    <% else %>
                                    <span class="text-muted">--</span>
                                    <% end %>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <%= link_to admin_fitness_device_usage_path(usage), class: "btn btn-sm btn-outline-primary" do %>
                                        <i class="fas fa-eye"></i>
                                        <% end %>

                                        <% if usage.in_use? %>
                                        <%= button_to admin_fitness_device_usage_path(usage), method: :patch, 
                                      params: { fitness_device_usage: { action: 'end_usage' } },
                                      confirm: '確定要結束此次使用嗎？',
                                      class: "btn btn-sm btn-outline-warning",
                                      form_class: "d-inline" do %>
                                        <i class="fas fa-stop"></i>
                                        <% end %>
                                        <% end %>

                                        <%= link_to admin_fitness_device_usage_path(usage), method: :delete,
                                  confirm: '確定要刪除此使用記錄嗎？',
                                  class: "btn btn-sm btn-outline-danger" do %>
                                        <i class="fas fa-trash"></i>
                                        <% end %>
                                    </div>
                                </td>
                            </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>

                <!-- 分頁 -->
                <div class="d-flex justify-content-center mt-3">
                    <%= paginate @usage_records, theme: 'twitter-bootstrap-4' if respond_to?(:paginate) %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        // 初始化 DataTable
        $('#usageTable').DataTable({
            "paging": false,
            "searching": false,
            "ordering": true,
            "info": false,
            "autoWidth": false,
            "responsive": true,
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/zh-HANT.json"
            },
            "order": [
                [3, "desc"]
            ] // 按開始時間倒序排列
        });

        // 初始化 tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>