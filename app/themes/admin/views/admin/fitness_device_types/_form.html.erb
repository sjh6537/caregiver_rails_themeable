<style>
    span.error {
        color: red;
        font-size: 14px;
    }
</style>

<%= simple_form_for [:admin, @fitness_device_type], :defaults => { :input_html => { :class => "form-control" } } do |f| %>
<%= f.error_notification %>

<div class="mb-4 main-content-label tx-success">基本資訊</div>
<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= t(:Name, scope: "Table") %></label>
        </div>
        <div class="col-md-9">
            <%= f.input :name, label: false, :placeholder => t(:Name, scope: "Table") %>
        </div>
    </div>
</div>

<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= t(:Descrition, scope: "Table") %></label>
        </div>
        <div class="col-md-9">
            <%= f.input :description, label: false, :placeholder => t(:Descrition, scope: "Table") %>
        </div>
    </div>
</div>

<div class="mb-4 main-content-label tx-success">顯示設定</div>
<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= t(:Icon, scope: "Table") %></label>
        </div>
        <div class="col-md-9">
            <%= f.input :icon, label: false, :placeholder => "例如: fas fa-running", hint: "請輸入 Font Awesome 圖示類別" %>
        </div>
    </div>
</div>

<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= t(:Icon_Color, scope: "Table") %></label>
        </div>
        <div class="col-md-9">
            <%= f.input :icon_color, as: :color, label: false, input_html: { class: "form-control", style: "height: 40px;" } %>
        </div>
    </div>
</div>

<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= t(:Sort_Order, scope: "Table") %></label>
        </div>
        <div class="col-md-9">
            <%= f.input :sort_order, label: false, :placeholder => "排序順序 (數字)", input_html: { type: "number", min: 0 } %>
        </div>
    </div>
</div>

<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= t(:Enabled, scope: "Table") %></label>
        </div>
        <div class="col-md-9">
            <div class="form-check">
                <%= f.check_box :enabled, class: "form-check-input" %>
                <label class="form-check-label">
                    <%= t(:Enable_Fitness_Device_Type, scope: "Table") %>
                </label>
            </div>
        </div>
    </div>
</div>

<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label">備註</label>
        </div>
        <div class="col-md-9">
            <%= f.input :notes, as: :text, label: false, :placeholder => "備註資訊", input_html: { rows: 3 } %>
        </div>
    </div>
</div>

<!-- ############# button ########### -->
<% if @fitness_device_type.new_record? %>
</div>
<div class="card-footer">
    <button type="submit" class="btn btn-primary waves-effect waves-light"><%= t(:CREATE, scope: "Button") %></button>
</div>
</div>
<% else %>
</div>
<div class="card-footer">
    <button type="submit" class="btn btn-primary waves-effect waves-light"><%= t(:UPDATE, scope: "Button") %></button>
    <a class="btn ripple btn-danger mg-l-10" data-target="#modal_del" data-toggle="modal" href="<%= admin_fitness_device_type_path(@fitness_device_type) %>"><%= t(:DELETE, scope: "Button") %></a>
</div>
</div>
<% end %>

<% end %>

<% unless @fitness_device_type.new_record? %>
<div class="modal" id="modal_del">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content tx-size-sm">
            <div class="modal-body tx-center pd-y-20 pd-x-20">
                <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true">&times;</span></button>
                <i class="las la-trash tx-100 tx-danger lh-1 mg-t-20 d-inline-block"></i>
                <h4 class="tx-danger mg-b-20"><%= t(:DEL_FITNESS_DEVICE_TYPE, scope: "Title") %></h4>
                <p class="mg-b-20 mg-x-20">確定要刪除此健身器材類型嗎？</p>
                <%= button_to t("Button.CONTINUE"), admin_fitness_device_type_path(@fitness_device_type), method: :delete, class: "btn btn-danger pd-x-25" %>
            </div>
        </div>
    </div>
</div>
<% end %>