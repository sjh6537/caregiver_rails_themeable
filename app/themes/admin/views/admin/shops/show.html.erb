	</div>
	</div>
</div>

<div class="row row-sm">
	<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
		<div class="card">
			<div class="card-body">
					<div class="main-profile-overview">

						<div class="d-flex justify-content-between mg-t-20">
								<div class="main-profile-name"><%= t("Table.Coupons") %></div>
								<a href="<%= admin_shop_new_coupon_path(@shop.id) %>" class="btn btn-success waves-effect waves-light"><%= t("Button.CREATE_NEW_COUPON") %></a>
						</div>


						<table id="example" class="table key-buttons text-md-nowrap card-table mb-0 table-vcenter">
							<thead>
								<tr>
									<th class="border-bottom-0 wd-lg-10p"><span></span></th>
									<th class="border-bottom-0 wd-lg-5p"><span><%= t("Table.Redeem") %></span></th>
									<th class="border-bottom-0 wd-lg-10p"><span><%= t("Table.Coupon_Name") %></span></th>
									<th class="border-bottom-0 wd-lg-15p"><span><%= t("Table.Discount") %></span></th>
									<th class="border-bottom-0 wd-lg-5p"><span><%= t("Table.is_Vaild") %></span></th>
									<th class="border-bottom-0 wd-lg-5p"><span><%= t("Table.Stock") %></span></th>
									<th class="border-bottom-0 wd-lg-5p"><span><%= t("Table.Used") %></span></th>
									<th class="border-bottom-0 wd-lg-5p"><span></span></th>
								</tr>
							</thead>
							<tbody>
								<% @shop.coupons.map do |c| %>
								<tr>
									<% if c.image_file_name.nil? %>
										<td></td>
									<% else %>
										<td><img alt="image" class="img-thumbnail wd-sm-100" src="<%= c.try(:full_image).try(:url) %>"></td>
									<% end %>
									<td><%= c.redeem %></td>
									<td><%= c.name %></td>
									<td><%= c.discount %></td>
									<td class="text-center">
										<% if c.is_vaild == true %>
											<span class="label text-success d-flex"><div class="dot-label bg-success mr-1 mg-b-25"></div></span>
										<% else %>
											<span class="label text-danger d-flex"><div class="dot-label bg-danger mr-1 mg-b-25"></div></span>
										<% end %>
									</td>
									<td><%= c.number_stock %></td>
									<td><%= c.number_used %></td>
									<td>
										<!-- <a href="<%= admin_shop_path(c.id) %>" class="btn btn-sm btn-primary"><i class="las la-search"></i></a> -->
										<a href="<%= admin_shop_edit_coupons_path(@shop.id,c.id) %>" class="btn btn-sm btn-info"><i class="las la-pen"></i></a>
										<!-- <a class="btn ripple btn-sm btn-danger mg-l-10 delete_button" data-val=<%= c.id %> data-target="#modal_del" data-toggle="modal" href=""><i class="las la-trash"></i></a> -->
									</td>
								</tr>
								<% end %>
							</tbody>
						</table>

					</div>
				</div>

			</div>
		</div>
	</div>
</div>
<!-- row closed -->

<%= content_for :script_js do %>

	<script type="text/javascript">

	let map;
	let marker;

	async function initMap() {
	  const { Map } = await google.maps.importLibrary("maps");
	  const location = new google.maps.LatLng(<%= @shop.latitude %>, <%= @shop.longitude %>);

	  map = new Map(document.getElementById("map"), {
		center: location,
		zoom: 16,
	  });

	  coordInfoWindow = new google.maps.InfoWindow();
	  coordInfoWindow.setContent("<%= @shop.name %>");
	  coordInfoWindow.setPosition(location)
	  coordInfoWindow.open(map);

	  marker = new google.maps.Marker({
		position: new google.maps.LatLng(location),
		map: map,
		label: {
			fontFamily: "FontAwesome",
			fontWeight: '100',
			text: eval("'\\u"+'f2e7'+"'"),
			color: 'blue',
			fontSize: "20px"
		},
		icon: {
			path: google.maps.SymbolPath.CIRCLE,
			scale: 0.5,
			strokeWeight: 1,
			strokeColor: 'black',
			strokeOpacity: 1,
			fillColor: '#0162e8',
			fillOpacity: 1
		},
	  });

	  marker.setMap(map);

	}

	$(document).ready(function() {
		initMap();
	});

	</script>

<% end %>