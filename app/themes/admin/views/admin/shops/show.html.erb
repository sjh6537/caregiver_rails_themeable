<div class="row row-sm">
	<div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 grid-margin">
	<div class="row row-sm">

		<div class="col-sm-6 col-lg-6 col-xl-6">
			<div class="main-content-body main-content-body-contacts card custom-card">
				<div class="main-contact-info-header pt-3">

					<div class="d-flex justify-content-between mg-t-20">
						<div>
							<h5 class="main-profile-name"><%= @shop.name %></h5>
						</div>
					</div>

					<hr class="mg-y-30">

					<div class="form-group ">
						<div class="row">
							<div class="col-md-3">
								<label class="form-label"><%= t(:is_Show, scope: "Table") %></label>
							</div>
							<div class="col-md-9">
								<label class="form-label"><%= @shop.show_text %></label>
							</div>
						</div>
					</div>
					<div class="form-group ">
						<div class="row">
							<div class="col-md-3">
								<label class="form-label">商家類型</label>
							</div>
							<div class="col-md-9">
								<label class="form-label"><%= @shop.category_text %></label>
							</div>
						</div>
					</div>
					<div class="form-group ">
						<div class="row">
							<div class="col-md-3">
								<label class="form-label"><%= t(:Phone, scope: "Table") %></label>
							</div>
							<div class="col-md-9">
								<label class="form-label"><%= @shop.phone %></label>
							</div>
						</div>
					</div>
					<div class="form-group ">
						<div class="row">
							<div class="col-md-3">
								<label class="form-label"><%= t(:Address, scope: "Table") %></label>
							</div>
							<div class="col-md-9">
								<label class="form-label"><%= @shop.all_address %></label>
							</div>
						</div>
					</div>

					<div class="form-group ">
						<div class="row">
							<div class="col-md-3">
								<label class="form-label">服務項目</label>
							</div>
							<div class="col-md-9">
								<label class="form-label"><%= @shop.service %></label>
							</div>
						</div>
					</div>

					<div class="form-group ">
						<div class="row">
							<div class="col-md-3">
								<label class="form-label">平均消費</label>
							</div>
							<div class="col-md-9">
								<label class="form-label"><%= @shop.price %></label>
							</div>
						</div>
					</div>

					<div class="form-group ">
						<div class="row">
							<div class="col-md-3">
								<label class="form-label">營業時間</label>
							</div>
							<div class="col-md-9">
								<label class="form-label"><%= @shop.opening %></label>
							</div>
						</div>
					</div>

					<div class="form-group ">
						<div class="row">
							<div class="col-md-3">
								<label class="form-label">簡介</label>
							</div>
							<div class="col-md-9">
								<label class="form-label"><%= @shop.description %></label>
							</div>
						</div>
					</div>

					<div class="form-group ">
						<div class="row">
							<div class="col-md-3">
								<label class="form-label"><%= t(:Created, scope: "Table") %></label>
							</div>
							<div class="col-md-9">
								<label class="form-label"><%= @shop.created_at.strftime('%Y/%m/%d %T') %></label>
							</div>
						</div>
					</div>
					<div class="form-group ">
						<div class="row">
							<div class="col-md-3">
								<label class="form-label"><%= t(:Last_Updated, scope: "Table") %></label>
							</div>
							<div class="col-md-9">
								<label class="form-label"><%= @shop.updated_at.strftime('%Y/%m/%d %T') %></label>
							</div>
