<style>
	span.error {
		color: red;
		font-size: 14px;
	}
</style>


<%= simple_form_for @category, :url => admin_request_category_index_path, :method => :post , :defaults => { :input_html => { :class => "form-control" } } do |f| %>
<%= f.error_notification %>

		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t(:Text, scope: "Table") %></label>
				</div>
				<div class="col-md-9">
					<%= f.input :text, label: false, :placeholder => t(:Text, scope: "Table") %>
				</div>
			</div>
		</div>

		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t(:is_Show, scope: "Table") %></label>
				</div>
				<div class="col-md-9">
					<%= f.input :is_show, label: false, :placeholder => t(:is_Show, scope: "Table") %>
				</div>
			</div>
		</div>


		<!-- ############# button ########### -->
		</div>
			<div class="card-footer">
				<button type="submit" class="btn btn-primary waves-effect waves-light"><%= t(:CREATE, scope: "Button") %></button>
			</div>
		</div>


<% end %>
