<style>
	span.error {
		color: red;
		font-size: 14px;
	}
</style>

<!-- Internal Select2 css -->
<link href="/assets/valex/plugins/select2/css/select2.min.css" rel="stylesheet">

<!--Internal  Datetimepicker-slider css -->
<link href="/assets/valex/plugins/amazeui-datetimepicker/css/amazeui.datetimepicker.css" rel="stylesheet">
<link href="/assets/valex/plugins/jquery-simple-datetimepicker/jquery.simple-dtpicker.css" rel="stylesheet">
<link href="/assets/valex/plugins/pickerjs/picker.min.css" rel="stylesheet">

<% if @coupon.new_record? %>
	<% url = admin_shop_coupons_path(@shop.id) %>
<% else %>
	<% url = admin_shop_update_coupons_path(@shop.id,@coupon.id) %>
<% end %>

<%= simple_form_for @coupon, :url => url, :defaults => { :input_html => { :class => "form-control" } } do |f| %>
<%= f.error_notification %>

		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t(:Coupon_Name, scope: "Table") %></label>
				</div>
				<div class="col-md-9">
					<%= f.input :name, label: false, :placeholder => t(:Coupon_Name, scope: "Table") %>
				</div>
			</div>
		</div>

		<div class="form-group">
			<div class="row">
                <div class="col-md-3"><label class="form-label"><%= t("Table.Discount") %></label></div>
				<div class="col-md-9">
                    <%= f.input :discount, label: false, :placeholder => t("Table.Discount"), :required => true %>
					<spin id="alert_address" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.Please_Input_Text") %></spin>
				</div>
			</div>
		</div>

		<div class="form-group">
			<div class="row">
				<div class="col-md-3"><label class="form-label"><%= t("Table.Comment") %></label></div>
				<div class="col-md-9">
					<%= f.input :comment, label: false, :placeholder => t("Table.Comment"), :required => true %>
					<spin id="alert_address" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.Please_Input_Text") %></spin>
				</div>
			</div>
		</div>


		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t(:is_Vaild, scope: "Table") %></label>
				</div>
				<div class="col-md-9">
					<%= f.input :is_vaild, label: false, :placeholder => t(:is_Vaild, scope: "Table") %>
				</div>
			</div>
		</div>

		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t(:Total, scope: "Table") %></label>
				</div>
				<div class="col-md-9">
					<%= f.input :number_total, label: false, :placeholder => t(:Total, scope: "Table") %>
				</div>
			</div>
		</div>

		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t(:Period_Start, scope: "Table") %></label>
				</div>
				<div class="col-md-9">
					<input class="form-control fc-datepicker" name="coupon[period_start]" placeholder="MM/DD/YYYY" type="text" value=<%= @coupon.period_start %>>
				</div>
			</div>
		</div>

		<div class="form-group ">
			<div class="row">
				<div class="col-md-3">
					<label class="form-label"><%= t(:Period_End, scope: "Table") %></label>
				</div>
				<div class="col-md-9">
					<input class="form-control fc-datepicker" name="coupon[period_end]" placeholder="MM/DD/YYYY" type="text" value=<%= @coupon.period_end %>>
				</div>

			</div>
		</div>

		<!-- ############# button ########### -->
		<% if @coupon.new_record? %>
			</div>
				<div class="card-footer">
					<button type="submit" class="btn btn-primary waves-effect waves-light"><%= t(:CREATE, scope: "Button") %></button>
				</div>
			</div>
		<% else %>
			</div>
				<div class="card-footer">
					<button type="submit" class="btn btn-primary waves-effect waves-light"><%= t(:UPDATE, scope: "Button") %></button>
					<a class="btn ripple btn-danger mg-l-10" data-target="#modal_del" data-toggle="modal" href=<%= admin_shop_destroy_coupons_path(@shop.id,@coupon.id) %> ><%= t(:DELETE, scope: "Button") %></a>
				</div>
			</div>
		<% end %>

<% end %>

	<div class="modal" id="modal_del">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content tx-size-sm">
				<div class="modal-body tx-center pd-y-20 pd-x-20">
					<button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true">&times;</span></button> <i class="las la-trash tx-100 tx-danger lh-1 mg-t-20 d-inline-block"></i>
					<h4 class="tx-danger mg-b-20"><%= t(:DEL_COUPON, scope: "Title") %></h4>
					<p class="mg-b-20 mg-x-20"><%= t(:Del_Coupon, scope: "Note") %></p>
					<form class="button_to" method="post" action=<%= admin_shop_destroy_coupons_path(@shop.id,@coupon.id) %> >
						<input type="hidden" name="_method" value="delete" autocomplete="off">
						<%= token_tag(nil) %>
						<button type="submit" aria-label="Close" class="btn btn-danger pd-x-25" data-method="DELETE"><%= t(:CONTINUE, scope: "Button") %></button>
					</form>
				</div>
			</div>
		</div>
	</div>



	<%= content_for :script_js do %>

		<script type="text/javascript">

			$(document).ready(function() {
				$('.fc-datepicker').datepicker({
					dateFormat: 'yy-mm-dd',
					showOtherMonths: true,
					selectOtherMonths: true
				});

			});

		</script>


	<!--Internal  Datepicker js -->
	<script src="/assets/valex/plugins/jquery-ui/ui/widgets/datepicker.js"></script>

	<!--Internal  jquery.maskedinput js -->
	<script src="/assets/valex/plugins/jquery.maskedinput/jquery.maskedinput.js"></script>

	<!--Internal  spectrum-colorpicker js -->
	<script src="/assets/valex/plugins/spectrum-colorpicker/spectrum.js"></script>

	<!-- Internal Select2.min js -->
	<script src="/assets/valex/plugins/select2/js/select2.min.js"></script>

	<!--Internal  jquery-simple-datetimepicker js -->
	<script src="/assets/valex/plugins/amazeui-datetimepicker/js/amazeui.datetimepicker.min.js"></script>

	<!-- Ionicons js -->
	<script src="/assets/valex/plugins/jquery-simple-datetimepicker/jquery.simple-dtpicker.js"></script>

	<!-- Internal Modal js-->
	<script src="/assets/valex/js/modal.js"></script>

	<!-- Internal form-elements js -->
	<script src="/assets/valex/js/form-elements.js"></script>


<% end %>


