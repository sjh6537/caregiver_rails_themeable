<style>
    span.error {
        color: red;
        font-size: 14px;
    }
</style>

<% if @user.nil? %>
<div class="alert alert-danger">
    使用者資料無法載入，請返回列表重試。
</div>
<% else %>
<%= simple_form_for [:admin, @user], :defaults => { :input_html => { :class => "form-control" } } do |f| %>
<%= f.error_notification %>

<div class="mb-4 main-content-label tx-success"><%= t("Title.USER_INFO") %></div>
<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= t("Table.Name") %> <span class="text-danger">*</span></label>
        </div>
        <div class="col-md-9">
            <%= f.input :name, label: false, :placeholder => t("Table.Name"), :required => true %>
            <spin id="alert_name" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.Please_Input_Text") %></spin>
        </div>
    </div>
</div>
<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= t("Table.Community") %> <span class="text-danger">*</span></label>
        </div>
        <div class="col-md-9">
            <% if current_admin.super_admin? %>
            <%= f.input :community_id, collection: @communities, label: false, include_blank: t(:Select_community, scope: "Table"), input_html: { class: "form-control", required: true } %>
            <spin id="alert_community" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.Please_Select_One_Community") %></spin>
            <% else %>
            <label class="form-label"><%= current_admin.community&.name || t(:Not_Assigned, scope: "Table") %></label>
            <%= f.input :community_id, as: :hidden %>
            <% end %>
        </div>
    </div>
</div>
<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= t("Table.ID_Card") %> <span class="text-danger">*</span></label>
        </div>
        <div class="col-md-9">
            <%= f.input :id_card, label: false, :placeholder => t("Table.ID_Card"), :required => true %>
            <spin id="alert_id_card" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.Please_Input_Text") %></spin>
        </div>
    </div>
</div>
<div class="form-group ">
    <div class="row">
        <div class="col-md-3">
            <label class="form-label"><%= t("Table.Phone") %> <span class="text-danger">*</span></label>
        </div>
        <div class="col-md-9">
            <%= f.input :phone, label: false, :placeholder => t("Table.Phone"), :required => true %>
            <spin id="alert_phone" class="alert_text text-danger tx-12"><%= raw t("Notify.Note.Please_Input_Text") %></spin>
        </div>
    </div>
</div>
<!-- ############# button ########### -->
<% if @user.new_record? %>
</div>
<div class="card-footer">
    <button type="submit" class="btn btn-primary waves-effect waves-light" onclick="return checkform()"><%= t("Button.CREATE") %></button>
</div>
</div>
<% else %>
</div>
<div class="card-footer">
    <button type="submit" class="btn btn-primary waves-effect waves-light" onclick="return checkform()"><%= t("Button.UPDATE") %></button>
</div>
</div>
<% end %>

<% end %>
<% end %>

<div class="modal" id="modal_del">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content tx-size-sm">
            <div class="modal-body tx-center pd-y-20 pd-x-20">
                <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true">&times;</span></button> <i class="las la-trash tx-100 tx-danger lh-1 mg-t-20 d-inline-block"></i>
                <h4 class="tx-danger mg-b-20"><%= t("Title.DEL_ADMIN") %></h4>
                <p class="mg-b-20 mg-x-20"><%= t("Note.Del_Admin") %></p><a aria-label="Close" class="btn btn-danger pd-x-25" type="button" href=<%= "/admins/#{@user.id}" %> data-method="DELETE"><%= t("Button.CONTINUE") %></a>
            </div>
        </div>
    </div>
</div>


<%= content_for :script_js do %>

<script type="text/javascript">
    function hide_alert() {
        $('#alert_name').hide();
        $('#alert_id_card').hide();
        $('#alert_id_card_error').hide();
        $('#alert_community').hide();
        $('#alert_phone').hide();
    }

    function checkform() {
        hide_alert();
        ret = true;

        if ($('#user_name').val() == "") {
            $('#alert_name').show();
            ret = false;
        }
        //身份證驗證
        if ($('#user_id_card').val() == "") {
            $('#alert_id_card').show();
            ret = false;
        } else {
            if (!isValidTaiwanID($('#user_id_card').val())) {
                $('#alert_id_card_error').show();
                ret = false;
            }
        }
        // 只有超級管理員需要檢查社區的選擇
        if ($('#user_community_id').length && $('#user_community_id').val() == "") {
            $('#alert_community').show();
            ret = false;
        }
        if ($('#user_phone').val() == "") {
            $('#alert_phone').show();
            ret = false;
        }


        if (ret == false)
            return false;
        else
            return true;
    }

    function alert_warning(text) {
        swal({
            title: 'WARNING!',
            text: text,
            type: 'warning',
            confirmButtonColor: '#57a94f'
        });
    };

    function alert_success(text) {
        swal({
            title: 'SUCCESS!',
            text: text,
            type: 'success',
            confirmButtonColor: '#57a94f'
        });
    };

    function isValidTaiwanID(id) {
        id = id.trim();

        if (id.length != 10) {
            console.log("Fail，長度不正確");
            return false
        }


        let countyCode = id.charCodeAt(0);
        if (countyCode < 65 | countyCode > 90) {
            console.log("Fail，字首英文代號，縣市不正確");
            return false
        }

        let genderCode = id.charCodeAt(1);
        if (genderCode != 49 && genderCode != 50) {
            console.log("Fail，性別代碼不正確");
            return false
        }

        let serialCode = id.slice(2)
        for (let i in serialCode) {
            let c = serialCode.charCodeAt(i);
            if (c < 48 | c > 57) {
                console.log("Fail，數字區出現非數字字元");
                return false
            }
        }

        let conver = "ABCDEFGHJKLMNPQRSTUVXYWZIO"
        let weights = [1, 9, 8, 7, 6, 5, 4, 3, 2, 1, 1]

        id = String(conver.indexOf(id[0]) + 10) + id.slice(1);

        checkSum = 0
        for (let i = 0; i < id.length; i++) {
            c = parseInt(id[i])
            w = weights[i]
            checkSum += c * w
        }

        return checkSum % 10 == 0
    }

    $(document).ready(function() {
        hide_alert();
    });
</script>

<% end %>