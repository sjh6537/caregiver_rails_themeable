<style>
    span.error {
        color: red;
        font-size: 14px;
    }
</style>


<%= simple_form_for [:admin, @schedule], :defaults => { :input_html => { :class => "form-control" } } do |f| %>
<%= f.error_notification %>
<div class="card-body">
    <div class="main-content-label mg-b-5">
        <%= t("Title.LINE_MESSAGE") %>
    </div>
    <p class="mg-b-20"><%= t("Note.Line_Message_Schedule_Note") %></p>
    <div id="schedule_event_setup">
        <h3><%= t("Tab.Line_Message") %></h3>
        <section>
            <p><%= t("Note.Line_Message_Setup_Message") %></p>
            <div class="form-group" data-parsley-validate="">
                <div class="row">
                    <label class="col-sm-2"><%= t("Table.Schedule_name") %></label>
                    <div class="col-sm-10">
                        <%= f.input :schedule_name, label: false, :placeholder => t("Website.Note.Please_Input_Title"), :required => true, id: "schedule_name" %>
                    </div>
                </div>
            </div>
            <div class="form-group" data-parsley-validate="">
                <div class="row ">
                    <label class="col-sm-2"><%= t("Table.Text") %></label>
                    <div class="col-sm-10">
                        <%= f.text_area :message_text, rows: 10, class: "form-control", placeholder: t("Website.Note.Please_Input_Text"), :required => true, id: "text_send_message" %>
                    </div>
                </div>
            </div>
            <div class="form-group" data-parsley-validate="">
                <div class="row">
                    <label class="col-sm-2"><%= t("Table.Execution_time") %></label>
                    <div class="col-sm-10">
                        <form class="col-sm-10" id="datetimeForm">
                            <input type="datetime-local" id="executimer"
                            <% if @schedule.scheduled_time.present? %>
                               value="<%= @schedule.scheduled_time.strftime('%Y-%m-%dT%H:%M') %>"
                            <% else %>
                                value=""
                            <% end %>>
                        </form>
                    </div>
                </div>
            </div>
        </section>
        <h3><%= t("Tab.Line_Recipient") %></h3>
        <section>
            <p><%= t("Note.Line_Message_Setup_Recipient") %></p>
            <div class="product-details table-responsive text-nowrap ht-450">
                <table class="table table-bordered table-hover mb-0 text-nowrap">
                    <thead>
                        <tr>
                            <th class="text-left"><%= t("Table.Recipient") %></th>
                            <th class="text-left"><%= t("Table.Action") %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% @users.each_with_index do |user, index| %>
                        <tr>
                            <td>
                                <div class="media">
                                    <div class="card-aside-img">
                                        <img src="<%= user.line_image %>" alt="img" class="h-60 w-60">
                                    </div>
                                    <div class="media-body">
                                        <div class="card-item-desc mt-0">
                                            <h6 class="font-weight-semibold mt-0 text-uppercase"><%= user.line_name %></h6>
                                            <dl class="card-item-desc-1">
                                              <dt><%= t("Table.Last_Sign_in") %></dt>
                                              <dd><%= user.updated_at.strftime('%Y/%m/%d %T') %></dd>
                                            </dl>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="form-group">
                                    <select name="quantity" id="recipient<%= user.id %>" class="form-control">
                                        <% if user.id == @user.id %>
                                        <option value="0"><%= t("Button.NON_SELECTED") %></option>
                                        <option value="1" selected><%= t("Button.SEND_MESSAGE") %></option>
                                        <% else %>
                                        <option value="0" selected><%= t("Button.NON_SELECTED") %></option>
                                        <option value="1"><%= t("Button.SEND_MESSAGE") %></option>
                                        <% end %>
                                    </select>
                                </div>
                            </td>
                        </tr>
                        <% end %>
                    </tbody>
                </table>
            </div>
            <!-- <div class="shopping-cart-footer">
                <div class="column"><a class="btn btn-danger btn-space clear_button" data-btn_src="text_send_message"><%= t("Button.RESET") %></a></div>
            </div> -->
        </section>
    </div>
</div>
<% end %>
<div>
    <div class="btn-list ml-auto" style="display:none">
        <button type="button" class="btn btn-primary btn-space send_button" id="send_button" data-msgtype="0" data-btn_src="text_send_message"><%= t("Button.UPDATE_SCHEDULE") %></button>
    </div>
</div>

<div class="modal" id="modal_del">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content tx-size-sm">
            <div class="modal-body tx-center pd-y-20 pd-x-20">
                <button aria-label="Close" class="close" data-dismiss="modal" type="button"><span aria-hidden="true">&times;</span></button> <i class="las la-trash tx-100 tx-danger lh-1 mg-t-20 d-inline-block"></i>
                <h4 class="tx-danger mg-b-20"><%= t("Title.DEL_ADMIN") %></h4>
                <p class="mg-b-20 mg-x-20"><%= t("Note.Del_Admin") %></p><a aria-label="Close" class="btn btn-danger pd-x-25" type="button" href=<%= "/admins/#{@user.id}" %> data-method="DELETE" ><%= t("Button.CONTINUE") %></a>
            </div>
        </div>
    </div>
</div>


<%= content_for :script_js do %>
    <script type="text/javascript">
        var now = new Date();
        var year = now.getFullYear();
        var month = (now.getMonth() + 1).toString().padStart(2, '0');
        var day = now.getDate().toString().padStart(2, '0');
        var hours = now.getHours().toString().padStart(2, '0');
        var minutes = now.getMinutes().toString().padStart(2, '0');
        var currentDatetime = `${year}-${month}-${day}T${hours}:${minutes}`;

        var initialFriendListHtml = $('#friend-list').html();

        $(document).on('click', '.send_button', function(obj) {
            var src_text = $(this).data('btn_src');
            var msgtype = $(this).data('msgtype');
            var text = $('#' + src_text).val();
            var image = $(this).data('image');
            var id = "null";
            var userId = "<%= @user.id %>";
            var scheduleId = "<%= @schedule.id %>";
            var link = "/users/" + userId + "/schedules/" + scheduleId + "/setup_schedule";
            var selectedDatetime = $('#executimer').val();
            var schedule_name = $("#user_schedule_schedule_name").val();
            var recipient = [];

            $('select[id^="recipient"]').each(function() {
                if ($(this).val() === '1') {
                    var userId = $(this).attr('id').replace('recipient', '');
                    recipient.push(userId);
                }
            });

            if(($('#' + src_text).val() == "") || (recipient == ""))
            {
                notif({
                    msg: "<%= t("Website.Note.Schedule_setup_fail") %>",
                    type: "error",
                    position: "center"
                });
                return;
            }

            $.ajax({
                type: "POST",
                url:  link,
                data: { "text": text, "user_id": userId, "image": image, "msgtype": msgtype, "recipient" : recipient, "datetime": selectedDatetime, "schedule_name": schedule_name},
                dataType: "JSON",
                beforeSend: function(xhr) {xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'))},
                headers: {'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')},
                error: function(jqXHR, textStatus, errorThrown)
                {
                    notif({
                        msg: "<%= t("Website.Note.Schedule_setup_fail") %>",
                        type: "error",
                        position: "center"
                    });
                },
                success: function(data)
                {
                    if(data.redirect_url)
                    {
                        window.location.href = data.redirect_url;
                    }
                }
            });
        });

        // Text/Timer
        $(document).ready(function()
        {
            <% if @schedule.scheduled_time.present? %>
            var currentDatetime = @schedule.scheduled_time;
            var currentText = @schedule.message_text;
            <% else %>
            var currentDatetime = `${year}-${month}-${day}T${hours}:${minutes}`;
            var currentText = "";
            <% end %>
            $('#text_send_message').val(currentText);
            $('#executimer').val(currentDatetime);
        });

        function hide_alert()
        {
            $('#alert_name').hide();
            $('#alert_phone').hide();
            $('#alert_address').hide();
            $('#alert_city').hide();
            $('#alert_postal').hide();
        }

        function checkform() {
            hide_alert();
            ret = true;

            if ($('#user_name').val() == ""){
                $('#alert_name').show();
                ret = false;
            }
            if ($('#user_phone').val() == ""){
                $('#alert_phone').show();
                ret = false;
            }
            if ($('#user_address').val() == ""){
                $('#alert_address').show();
                ret = false;
            }
            if ($('#user_addr_city').val() == "0"){
                $('#alert_city').show();
                ret = false;
            }
            if ($('#user_addr_postal').val() == "0"){
                $('#alert_postal').show();
                ret = false;
            }

            if (ret == false)
                return false;
            else
                return true;
        }

        function refresh_select(data) {
            $('#user_addr_postal').empty();
            $('#user_addr_postal').append('<option value="0"><%= t(:Select_postal, scope: "Table") %></option>');
            $('#user_addr_postal').append(data);
        }

        $(document).on('change', '#user_addr_city', function(event) {
            city_code = $('#user_addr_city').val();
            $('#alert_city').hide();
            $('#alert_postal').hide();

            if ($('#user_addr_city').val() == "0"){
                $('#alert_city').show();
                $('#user_addr_city').focus();
            }

            if ($('#user_addr_postal').val() == "0"){
                $('#alert_postal').show();
                $('#user_addr_postal').focus();
            }

            refresh_select(get_postal_selection(city_code));
        });

        $(document).on('change', '#user_addr_postal', function(event) {
            $('#alert_postal').hide();

            if ($('#user_addr_postal').val() == "0"){
                $('#alert_postal').show();
                $('#user_addr_postal').focus();
            }
        });

        function get_postal_selection(city)
        {
            switch (city){
                default:
                case "1":
                    html_text = '<%= get_postal_selection(1) %>'
                    break;
                case "2":
                    html_text = '<%= get_postal_selection(2) %>'
                    break;
                case "3":
                    html_text = '<%= get_postal_selection(3) %>'
                    break;
                case "4":
                    html_text = '<%= get_postal_selection(4) %>'
                    break;
                case "5":
                    html_text = '<%= get_postal_selection(5) %>'
                    break;
                case "6":
                    html_text = '<%= get_postal_selection(6) %>'
                    break;
                case "7":
                    html_text = '<%= get_postal_selection(7) %>'
                    break;
                case "8":
                    html_text = '<%= get_postal_selection(8) %>'
                    break;
                case "9":
                    html_text = '<%= get_postal_selection(9) %>'
                    break;
                case "10":
                    html_text = '<%= get_postal_selection(10) %>'
                    break;
                case "11":
                    html_text = '<%= get_postal_selection(11) %>'
                    break;
                case "12":
                    html_text = '<%= get_postal_selection(12) %>'
                    break;
                case "13":
                    html_text = '<%= get_postal_selection(13) %>'
                    break;
                case "14":
                    html_text = '<%= get_postal_selection(14) %>'
                    break;
                case "15":
                    html_text = '<%= get_postal_selection(15) %>'
                    break;
                case "16":
                    html_text = '<%= get_postal_selection(16) %>'
                    break;
                case "17":
                    html_text = '<%= get_postal_selection(17) %>'
                    break;
                case "18":
                    html_text = '<%= get_postal_selection(18) %>'
                    break;
                case "19":
                    html_text = '<%= get_postal_selection(19) %>'
                    break;
                case "20":
                    html_text = '<%= get_postal_selection(20) %>'
                    break;
                case "21":
                    html_text = '<%= get_postal_selection(21) %>'
                    break;
                case "22":
                    html_text = '<%= get_postal_selection(22) %>'
                    break;
                case "23":
                    html_text = '<%= get_postal_selection(23) %>'
                    break;
                case "24":
                    html_text = '<%= get_postal_selection(24) %>'
                    break;
            }
            return html_text
        }

        function alert_warning(text)
        {
            swal(
                {
                    title: 'WARNING!',
                    text: text,
                    type: 'warning',
                    confirmButtonColor: '#57a94f'
                });
        };

        function alert_success(text)
        {
            swal(
                {
                    title: 'SUCCESS!',
                    text: text,
                    type: 'success',
                    confirmButtonColor: '#57a94f'
                });
        };

        $(document).ready(function() {
            hide_alert();

            if (<%= @user.addr_city %> != 0){
                refresh_select(get_postal_selection('<%= @user.addr_city %>'));
                if (<%= @user.addr_postal %> != 0){
                    $('#user_addr_postal').val('<%= @user.addr_postal %>').attr('selected','selected');
                }
            }

        });

    </script>

<% end %>
