<style>
    .side-menu__icon {
        height: auto !important;
    }
</style>

<!-- main-sidebar -->
<div class="app-sidebar__overlay" data-toggle="sidebar"></div>
<aside class="app-sidebar sidebar-scroll">
    <!-- logo -->
    <div class="main-sidebar-header active">
        <a class="desktop-logo logo-light active tx-orange font-weight-bold" href="index.html"><%= current_community&.name.presence || APP_CONFIG[:site_name_eng] %>
            <!-- <img  class="main-logo" alt="logo" src="/assets/valex/img/logo/logo.png"> -->
        </a>
        <a class="logo-icon mobile-logo icon-light tx-orange font-weight-bold active" href="index.html"><%= current_community&.name.presence || APP_CONFIG[:site_name_eng] %>
            <!-- <img  class="logo-icon" alt="logo" src="/assets/valex/img/logo/logo.png"> -->
        </a>
    </div>

    <div class="main-sidemenu">
        <!-- admin user -->
        <div class="app-sidebar__user clearfix">
            <div class="dropdown user-pro-body">
                <div class="">
                    <img alt="user-img" class="avatar avatar-xl brround" src="<%= community_logo_url || '/assets/valex/img/logo/logo.png' %>"><span class="avatar-status profile-status bg-green"></span>
                </div>
                <div class="user-info">
                    <h4 class="font-weight-semibold mt-3 mb-0"><%= current_admin.name %></h4>
                    <span class="mb-0 text-muted">
                        <%= current_admin.type %>
                    </span>
                </div>
            </div>
        </div>

        <ul class="side-menu">
            <!-- <li class="side-item side-item-category">Main</li> -->
            <li class="slide">
                <a class="side-menu__item" href="<%= admin_root_path %>">
                    <i class="side-menu__icon fas fa-tachometer-alt"></i><span class="side-menu__label"><%= t("Sidebar.Item.DashBoard") %></span>
                </a>
            </li>

            <% if current_admin.super_admin? %>
            <li class="slide">
                <a class="side-menu__item" href="<%= admin_admins_path %>">
                    <i class="side-menu__icon far fa-address-card"></i><span class="side-menu__label"><%= t("Sidebar.Item.Administrator") %></span><span class="badge badge-success side-badge"><%= Admin.where(super_admin:false).count %></span>
                </a>
            </li>
            <% end %>

            <li class="slide">
                <a class="side-menu__item" href="<%= edit_admin_community_theme_path %>">
                    <i class="side-menu__icon fas fa-palette"></i><span class="side-menu__label">社群主題設定</span>
                </a>
            </li>

            <li class="slide">
                <a class="side-menu__item" href="<%= admin_users_path %>">
                    <i class="side-menu__icon far fa-solid fa-user"></i><span class="side-menu__label"><%= t("Sidebar.Item.Users") %></span><span class="badge badge-success side-badge"><%= current_admin.super_admin? ? User.count : User.where(community_id: current_admin.community_id).count %></span>
                </a>
            </li>

            <li class="slide">
                <a class="side-menu__item" href="<%= admin_shops_path %>">
                    <i class="side-menu__icon far fa-solid fa-shop"></i><span class="side-menu__label"><%= t("Sidebar.Item.Shops") %></span><span class="badge badge-success side-badge"><%= Shop.count %></span>
                </a>
            </li>

            <li class="slide hide">
                <a class="side-menu__item" href="<%= admin_request_category_index_path %>">
                    <i class="side-menu__icon far fa-solid fa-icons"></i><span class="side-menu__label"><%= t("Sidebar.Item.Request_Category") %></span>
                </a>
            </li>
            <li class="slide">
                <a class="side-menu__item" href="<%= admin_schedule_messages_path %>">
                    <i class="side-menu__icon far fa-solid fa-message"></i><span class="side-menu__label"><%= t("Sidebar.Item.Line_Message") %></span>
                    <% if ScheduleMessage.where(status: SCHEDULE_MESSAGE_NEW).count != 0 %>
                    <span class="badge badge-success side-badge"><%= ScheduleMessage.where(status: SCHEDULE_MESSAGE_NEW).count %></span>
                    <% end %>
                </a>
            </li>

            <% if current_admin.super_admin? %>
            <li class="slide">
                <a class="side-menu__item" data-toggle="slide" href="#">
                    <i class="side-menu__icon fas fa-dumbbell"></i><span class="side-menu__label"><%= t(:Fitness_Management, scope: "Sidebar.Item") %></span><i class="angle fe fe-chevron-down"></i>
                </a>
                <ul class="slide-menu">
                    <li>
                        <a class="slide-item d-flex justify-content-between align-items-center" href="<%= admin_fitness_device_types_path %>">
                            <span><%= t(:Fitness_Device_Types, scope: "Sidebar.Item") %></span>
                            <span class="badge bg-info"><%= FitnessDeviceType.count %></span>
                        </a>
                    </li>
                    <li>
                        <a class="slide-item d-flex justify-content-between align-items-center" href="<%= admin_fitness_devices_path %>">
                            <span><%= t(:Fitness_Devices, scope: "Sidebar.Item") %></span>
                            <span class="badge bg-success"><%= FitnessDevice.count %></span>
                        </a>
                    </li>
                    <li>
                        <a class="slide-item d-flex justify-content-between align-items-center" href="<%= admin_fitness_device_usages_path %>">
                            <span><%= t(:Fitness_Device_Usages, scope: "Sidebar.Item") %></span>
                            <span class="badge bg-warning"><%= FitnessDeviceUsage.count %></span>
                        </a>
                    </li>
                </ul>
            </li>
            <% end %>

        </ul>
    </div>
</aside>
<!-- main-sidebar -->