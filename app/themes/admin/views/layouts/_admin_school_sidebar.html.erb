
<style>

	.side-menu__icon {
		height: auto !important;
	}

</style>

	<!-- main-sidebar -->
	<div class="app-sidebar__overlay" data-toggle="sidebar"></div>
	<aside class="app-sidebar sidebar-scroll">
		<!-- logo -->
		<div class="main-sidebar-header active">
			<% if !@website.logo.nil? && @website.logo.asset? %>
			<a class="desktop-logo logo-light active" href="index.html">
				<img  class="main-logo" alt="logo" src="<%= @website.try(:logo).try(:asset).try(:url) %>">
			</a>
			<% end %>
			<% if !@website.favicon.nil? && @website.favicon.asset? %>
			<a class="logo-icon mobile-logo icon-light active" href="index.html">
				<img  class="logo-icon" alt="logo" src="<%= @website.try(:favicon).try(:asset).try(:url) %>">
			</a>
			<% end %>
		</div>

		<div class="main-sidemenu">
			<!-- admin user -->
			<div class="app-sidebar__user clearfix">
				<div class="dropdown user-pro-body">
					<div class="">
						<img alt="user-img" class="avatar avatar-xl brround" src="/assets/valex/img/faces/6.jpg"><span class="avatar-status profile-status bg-green"></span>
					</div>
					<div class="user-info">
						<h4 class="font-weight-semibold mt-3 mb-0"><%= current_admin.name %></h4>
						<span class="mb-0 text-muted">
							<%= current_admin.type %>
					</div>
				</div>
			</div>

			<ul class="side-menu">
				<!-- <li class="side-item side-item-category">Main</li> -->

				<li class="slide">
					<a class="side-menu__item" href=<%= customer_school_root_path %>>
						<i class="side-menu__icon fas fa-tachometer-alt"></i><span class="side-menu__label"><%= t(:DashBoard , scope: "Sidebar.Item") %></span><span class="badge badge-danger side-badge">20</span>
					</a>
				</li>

				<li class="slide">
					<a class="side-menu__item" data-toggle="slide" href="#">
						<i class="side-menu__icon fas fa-bell"></i><span class="side-menu__label"><%= t(:Line_Notify , scope: "Sidebar.Item") %></span>
						<i class="angle fe fe-chevron-down"></i>
					</a>
					<ul class="slide-menu">
						<li>
							<a class="slide-item" href=<%= customer_school_line_notify_teaching_path(0) %>><%= t(:Teaching , scope: "Sidebar.Item") %></a>
							<span class="badge badge-warning side-badge">Hot</span>
						</li>
						<li>
							<a class="slide-item" href=<%= customer_school_line_notify_index_path %>><%= t(:Register , scope: "Sidebar.Item") %></a>
						</li>
						<li>
							<a class="slide-item" href=<%= customer_school_line_notify_message_path %>><%= t(:Message , scope: "Sidebar.Item") %></a>
						</li>
					</ul>
				</li>
				<li class="slide">
					<a class="side-menu__item" data-toggle="slide" href="#">
						<i class="side-menu__icon icon ion-md-pricetags"></i><span class="side-menu__label"><%= t(:School , scope: "Sidebar.Item") %></span>
						<i class="angle fe fe-chevron-down"></i>
					</a>
					<ul class="slide-menu">
						<li>
							<a class="slide-item" href=<%= customer_school_admins_path %>><%= t(:Administrator , scope: "Sidebar.Item") %></a>
							<span class="badge badge-success side-badge"><%= current_admin.customer.admins.count %></span>
						</li>
						<li>
							<a class="slide-item" href=<%= customer_school_groups_path %>><%= t(:Group , scope: "Sidebar.Item") %></a>
							<span class="badge badge-success side-badge"><%= current_admin.customer.groups.count %></span>
						</li>
						<li>
							<a class="slide-item" href=<%= customer_school_teachers_path %>><%= t(:Teachers , scope: "Sidebar.Item") %></a>
							<span class="badge badge-success side-badge"><%= current_admin.customer.teachers.count %></span>
						</li>
						<li>
							<a class="slide-item" href=<%= customer_school_students_path %>><%= t(:Students , scope: "Sidebar.Item") %></a>
							<span class="badge badge-success side-badge"><%= current_admin.customer.students.count %></span>
						</li>
					</ul>
				</li>

			</ul>
		</div>
	</aside>
	<!-- main-sidebar -->
