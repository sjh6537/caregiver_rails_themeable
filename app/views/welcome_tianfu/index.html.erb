  </main>

  <footer class="bg-stone-900 text-stone-400 py-12 border-t-4 border-amber-600">
    <div class="container mx-auto px-4 text-center text-xs">
      <p>© 2024 西湖天福宮 All Rights Reserved.</p>
    </div>
