    <!-- ================= VIEW: CONTACT ================= -->
    <div id="view-contact" class="page-view hidden animate-fade-in pt-24 pb-20 bg-stone-100 min-h-screen">
      <div class="container mx-auto px-4 max-w-5xl">
        <h1 class="text-4xl font-serif font-bold text-center text-stone-800 mb-6">聯絡我們</h1>
        
        <div class="grid md:grid-cols-2 gap-8">
          <div class="space-y-8">
            <div class="bg-white p-8 rounded-xl shadow-md border-l-4 border-red-700">
              <h3 class="text-xl font-bold text-stone-800 mb-4 flex items-center">
                <div class="bg-red-100 p-2 rounded-full mr-3 text-red-700"><i data-lucide="home" class="w-5 h-5"></i></div>
                西湖天福宮
              </h3>
              <div class="space-y-4 text-stone-600 ml-2">
                <p>地址：苗栗縣西湖鄉金獅村2鄰9號</p>
                <p>電話：037-923966</p>
              </div>
            </div>
          </div>
          <div class="bg-white p-8 rounded-xl shadow-lg">
            <h3 class="text-2xl font-bold text-stone-800 mb-6">傳送訊息</h3>
            <form>
               <div class="mb-4"><input type="text" class="w-full border p-2 rounded" placeholder="姓名"></div>
               <div class="mb-4"><input type="text" class="w-full border p-2 rounded" placeholder="電話"></div>
               <div class="mb-4"><textarea class="w-full border p-2 rounded h-32" placeholder="內容"></textarea></div>
