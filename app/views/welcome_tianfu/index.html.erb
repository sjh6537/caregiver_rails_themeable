        <h3 class="text-2xl font-bold text-stone-800 mb-6 border-l-4 border-red-700 pl-4">宮廟祈福服務</h3>
        <div class="grid md:grid-cols-3 gap-8 mb-16">
          <% @services_data.each do |s| %>
