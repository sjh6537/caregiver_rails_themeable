</div>

<!-- ================= JAVASCRIPT LOGIC ================= -->
<script>
  // Initialize Icons
  lucide.createIcons();

  // Navigation Logic
  function navigateTo(page) {
    // Scroll to top
    window.scrollTo({ top: 0, behavior: 'smooth' });
    
    // Hide all views
    document.querySelectorAll('.page-view').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.page-view').forEach(el => el.classList.remove('block'));
    
    // Show target view
    const target = document.getElementById('view-' + page);
    if(target) {
       target.classList.remove('hidden');
       target.classList.add('block');
    }

    // Update Nav Styles (Simple)
    document.querySelectorAll('.nav-link').forEach(el => {
       if(el.dataset.page === page) {
         el.classList.add('text-amber-400', 'border-b-2', 'border-amber-400');
         el.classList.remove('text-stone-200');
       } else {
         el.classList.remove('text-amber-400', 'border-b-2', 'border-amber-400');
         el.classList.add('text-stone-200');
       }
    });
  }

  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    menu.classList.toggle('hidden');
  }
  
  // Navbar Scroll Effect
  window.addEventListener('scroll', () => {
    const navbar = document.getElementById('navbar');
    const title = document.getElementById('nav-title');
    if (window.scrollY > 50) {
      navbar.classList.add('bg-red-950/95', 'shadow-md', 'py-2');
      navbar.classList.remove('bg-transparent', 'py-4');
      title.classList.add('text-amber-400');
      title.classList.remove('text-white');
    } else {
      navbar.classList.remove('bg-red-950/95', 'shadow-md', 'py-2');
      navbar.classList.add('bg-transparent', 'py-4');
      title.classList.remove('text-amber-400');
      title.classList.add('text-white');
    }
  });

  // --- Gemini API Logic ---
  const apiKey = ""; // API Key

  async function callGemini(prompt) {
    try {
      const response = await fetch(
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] }),
        }
      );
      if (!response.ok) throw new Error('API Error');
      const data = await response.json();
      return data.candidates?.[0]?.content?.parts?.[0]?.text || "廟公忙碌中...";
    } catch (e) {
      console.error(e);
      return "連線錯誤，請稍後再試。";
    }
  }

  // Feature: AI Guide
  async function askAIGuide() {
    const input = document.getElementById('guide-input').value;
    const btn = document.getElementById('guide-btn');
    const resBox = document.getElementById('guide-response');
    const resText = document.getElementById('guide-text');
    
    if(!input) return;
    btn.disabled = true;
    btn.innerText = '...';
    
    const prompt = `你現在是苗栗西湖天福宮的「AI 導覽員」。請回答：${input}`;
    const text = await callGemini(prompt);
    
    resText.innerText = text;
    resBox.classList.remove('hidden');
    btn.disabled = false;
    btn.innerText = '提問';
  }

  // Feature: AI Recommendation
  async function recommendService() {
    const input = document.getElementById('service-input').value;
    const btn = document.getElementById('service-btn');
    const resBox = document.getElementById('service-result');
    const resText = document.getElementById('service-text');
    
    if(!input) return;
    btn.disabled = true;
    btn.innerText = '...';
    
    const prompt = `使用者在找西湖天福宮服務（安太歲/平安燈/送餐捐款/文化體驗）。需求：${input}。請推薦適合項目。`;
    const text = await callGemini(prompt);
    
    resText.innerText = text;
    resBox.classList.remove('hidden');
    btn.disabled = false;
    btn.innerText = '推薦';
  }

  // --- Fortune Telling Logic ---
  const fortunePoems = <%= raw @fortune_poems_json %>;
  let currentResult = null;

  function setFortuneStep(step) {
    ['intro', 'form', 'praying', 'result'].forEach(s => {
       const el = document.getElementById('fortune-' + s);
       if(s === step) {
         el.classList.remove('hidden');
         el.classList.add('flex');
       } else {
         el.classList.add('hidden');
         el.classList.remove('flex');
       }
    });
  }

  async function askAIPrayer() {
    const wish = document.getElementById('user-wish').value;
    const name = document.getElementById('user-name').value;
    const btn = document.getElementById('prayer-ai-btn');
    
    if(!wish) { alert('請先輸入所求事項'); return; }
    
    btn.disabled = true;
    btn.innerText = '潤飾中...';
    
    const prompt = `請將祈願內容改寫為誠懇疏文。姓名：${name}。內容：${wish}`;
    const text = await callGemini(prompt);
    
    document.getElementById('user-wish').value = text;
    btn.disabled = false;
    btn.innerHTML = '<i data-lucide="sparkles" class="w-3 h-3 mr-1"></i> AI 幫我寫疏文';
    lucide.createIcons();
  }

  function drawFortune() {
    document.getElementById('praying-action').classList.add('hidden');
    document.getElementById('praying-spinner').classList.remove('hidden');
    document.getElementById('praying-spinner').classList.add('flex');
    
    setTimeout(() => {
       const random = fortunePoems[Math.floor(Math.random() * fortunePoems.length)];
       currentResult = random;
       
       document.getElementById('res-title').innerText = random.title;
       document.getElementById('res-poem').innerText = random.poem;
       document.getElementById('res-explain').innerText = random.explain;
       
       document.getElementById('praying-action').classList.remove('hidden');
       document.getElementById('praying-spinner').classList.add('hidden');
       document.getElementById('praying-spinner').classList.remove('flex');
       
       setFortuneStep('result');
    }, 2000);
  }

  async function askAIMaster() {
    const q = document.getElementById('interp-input').value;
    const btn = document.getElementById('interp-btn');
    const resBox = document.getElementById('interp-result');
    const resText = document.getElementById('interp-text');
    
    if(!q) return;
    btn.disabled = true;
    btn.innerText = '...';
    
    const prompt = `你是西湖天福宮廟公。籤詩：${currentResult.poem}。信眾問：${q}。請指點。`;
    const text = await callGemini(prompt);
    
    resText.innerText = text;
    resBox.classList.remove('hidden');
    btn.disabled = false;
    btn.innerText = '詢問';
  }
</script>

<style>
  .animate-fade-in { animation: fadeIn 0.5s ease-out; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>