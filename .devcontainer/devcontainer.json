{
  "name": "Caregiver Rails（稻相顧多）",
  "dockerComposeFile": "../docker-compose.dev.yml",
  "service": "web",
  "workspaceFolder": "/rails",

  "forwardPorts": [3000, 3306, 6379],
  "portsAttributes": {
    "3000": {
      "label": "Rails",
      "onAutoForward": "notify"
    },
    "3306": {
      "label": "MySQL"
    },
    "6379": {
      "label": "Redis"
    }
  },

  "postCreateCommand": "bundle install",

  "customizations": {
    "vscode": {
      "extensions": [
        "shopify.ruby-lsp",
        "bung87.rails",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "[ruby]": {
          "editor.defaultFormatter": "Shopify.ruby-lsp",
          "editor.tabSize": 2
        }
      }
    }
  },

  "remoteUser": "root"
}
